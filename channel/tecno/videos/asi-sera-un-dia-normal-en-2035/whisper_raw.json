[
  {
    "file": "v3_0_00.jpg",
    "startSec": 0.0,
    "text": "son las 7 de la mañana"
  },
  {
    "file": "v3_0_01.jpg",
    "startSec": 1.16,
    "text": "de un martes de 2035."
  },
  {
    "file": "v3_0_03.jpg",
    "startSec": 3.48,
    "text": "¿Tú casa ya está calentita?"
  },
  {
    "file": "v3_0_05.jpg",
    "startSec": 5.22,
    "text": "¿Y no tienes caldera?"
  },
  {
    "file": "v3_0_06.jpg",
    "startSec": 6.62,
    "text": "Abajo te espera un taxi,"
  },
  {
    "file": "v3_0_08.jpg",
    "startSec": 8.28,
    "text": "sin nadie al volante."
  },
  {
    "file": "v3_0_09.jpg",
    "startSec": 9.7,
    "text": "Parece ciencia ficción,"
  },
  {
    "file": "v3_0_11.jpg",
    "startSec": 11.3,
    "text": "pero todo lo de este día"
  },
  {
    "file": "v3_0_12.jpg",
    "startSec": 12.44,
    "text": "ya se está construyendo hoy."
  },
  {
    "file": "v3_0_14.jpg",
    "startSec": 14.3,
    "text": "Otra cosa es que llegue todo."
  },
  {
    "file": "v3_0_16.jpg",
    "startSec": 16.14,
    "text": "Algunas lo tienen difícil."
  },
  {
    "file": "v3_0_17.jpg",
    "startSec": 17.82,
    "text": "Y una ya tuvo fecha para dentro de un año."
  },
  {
    "file": "v3_0_20.jpg",
    "startSec": 20.2,
    "text": "De eso hace 7."
  },
  {
    "file": "v3_0_21.jpg",
    "startSec": 21.46,
    "text": "¿A divinas cuál?"
  },
  {
    "file": "v3_0_22.jpg",
    "startSec": 22.44,
    "text": "Estas son las 10 cosas que verás ese día."
  },
  {
    "file": "v3_0_25.jpg",
    "startSec": 25.24,
    "text": "Te las cuento de una en una"
  },
  {
    "file": "v3_0_26.jpg",
    "startSec": 26.46,
    "text": "de la mañana a la noche."
  },
  {
    "file": "v3_0_28.jpg",
    "startSec": 28.22,
    "text": "Número 1."
  },
  {
    "file": "v3_0_29.jpg",
    "startSec": 28.9,
    "text": "La 7 de la mañana."
  },
  {
    "file": "v3_0_30.jpg",
    "startSec": 30.72,
    "text": "Te despiertas."
  },
  {
    "file": "v3_0_31.jpg",
    "startSec": 31.78,
    "text": "El calor sale de una bomba de calor."
  },
  {
    "file": "v3_0_33.jpg",
    "startSec": 33.88,
    "text": "Y la luz de las placas del tejado."
  },
  {
    "file": "v3_0_35.jpg",
    "startSec": 35.9,
    "text": "Esto ya es ley."
  },
  {
    "file": "v3_0_37.jpg",
    "startSec": 37.18,
    "text": "Según la directiva europea de edificios,"
  },
  {
    "file": "v3_0_39.jpg",
    "startSec": 39.2,
    "text": "desde 2030 todos los nuevos"
  },
  {
    "file": "v3_0_40.jpg",
    "startSec": 40.94,
    "text": "serán de cero emisiones."
  },
  {
    "file": "v3_0_42.jpg",
    "startSec": 42.62,
    "text": "Y para 2020,"
  },
  {
    "file": "v3_0_44.jpg",
    "startSec": 44.06,
    "text": "Europa quiere dejar de calentar"
  },
  {
    "file": "v3_0_45.jpg",
    "startSec": 45.32,
    "text": "casas con gas y gasoleo."
  },
  {
    "file": "v3_0_47.jpg",
    "startSec": 47.04,
    "text": "El problema es que España tenía"
  },
  {
    "file": "v3_0_48.jpg",
    "startSec": 48.6,
    "text": "que adaptar la ley antes de junio."
  },
  {
    "file": "v3_0_50.jpg",
    "startSec": 50.48,
    "text": "Y en mayo iba por el 60%."
  },
  {
    "file": "v3_0_52.jpg",
    "startSec": 52.78,
    "text": "La casa del futuro ya se construye."
  },
  {
    "file": "v3_0_55.jpg",
    "startSec": 55.2,
    "text": "El piso de tu abuela sigue igual."
  },
  {
    "file": "v3_0_57.jpg",
    "startSec": 57.18,
    "text": "Número 2."
  },
  {
    "file": "v3_0_58.jpg",
    "startSec": 57.84,
    "text": "La 7 y media."
  },
  {
    "file": "v3_0_59.jpg",
    "startSec": 59.44,
    "text": "El desayuno."
  },
  {
    "file": "v3_1_00.jpg",
    "startSec": 60.44,
    "text": "Un tas paté en la tostara."
  },
  {
    "file": "v3_1_02.jpg",
    "startSec": 62.18,
    "text": "Y ese patón nunca existió,"
  },
  {
    "file": "v3_1_03.jpg",
    "startSec": 63.9,
    "text": "salió de células cultivadas."
  },
  {
    "file": "v3_1_05.jpg",
    "startSec": 65.54,
    "text": "Fue la de Europa ya se vende."
  },
  {
    "file": "v3_1_07.jpg",
    "startSec": 67.26,
    "text": "Singapura provó la carne cultivada en 2020"
  },
  {
    "file": "v3_1_09.jpg",
    "startSec": 69.34,
    "text": "y Estados Unidos en 2023."
  },
  {
    "file": "v3_1_11.jpg",
    "startSec": 71.86,
    "text": "Y en San Sebastián,"
  },
  {
    "file": "v3_1_13.jpg",
    "startSec": 73.06,
    "text": "biotec futs empezó a construir"
  },
  {
    "file": "v3_1_14.jpg",
    "startSec": 74.64,
    "text": "una planta para mil toneladas al año."
  },
  {
    "file": "v3_1_16.jpg",
    "startSec": 76.92,
    "text": "Pero en Italia la han prohibido"
  },
  {
    "file": "v3_1_18.jpg",
    "startSec": 78.38,
    "text": "por ley y la unión"
  },
  {
    "file": "v3_1_19.jpg",
    "startSec": 79.52,
    "text": "europea todavía no ha probado ninguna."
  },
  {
    "file": "v3_1_21.jpg",
    "startSec": 81.9,
    "text": "La carne del futuro ya existe."
  },
  {
    "file": "v3_1_23.jpg",
    "startSec": 83.84,
    "text": "Lo difícil es que te dejen comprarla."
  },
  {
    "file": "v3_1_26.jpg",
    "startSec": 86.18,
    "text": "Número 3."
  },
  {
    "file": "v3_1_27.jpg",
    "startSec": 86.72,
    "text": "La 8 y 4."
  },
  {
    "file": "v3_1_28.jpg",
    "startSec": 88.36,
    "text": "Te vas al curro."
  },
  {
    "file": "v3_1_29.jpg",
    "startSec": 89.46,
    "text": "Te subes al taxi y el podante gira solo."
  },
  {
    "file": "v3_1_32.jpg",
    "startSec": 92.14,
    "text": "Waymo, la empresa hermana de Google,"
  },
  {
    "file": "v3_1_34.jpg",
    "startSec": 94.14,
    "text": "ya circula sin conductor en más de 10"
  },
  {
    "file": "v3_1_35.jpg",
    "startSec": 95.9,
    "text": "ciudades de Estados Unidos."
  },
  {
    "file": "v3_1_37.jpg",
    "startSec": 97.62,
    "text": "A principios de este año daba unos 500"
  },
  {
    "file": "v3_1_39.jpg",
    "startSec": 99.48,
    "text": "mil viajes de pago a la semana."
  },
  {
    "file": "v3_1_41.jpg",
    "startSec": 101.62,
    "text": "En Europa quieren empezar por Londres."
  },
  {
    "file": "v3_1_43.jpg",
    "startSec": 103.6,
    "text": "Para España no ha dado ninguna fecha."
  },
  {
    "file": "v3_1_45.jpg",
    "startSec": 105.7,
    "text": "O sea, el coche sin conductor ya existe."
  },
  {
    "file": "v3_1_48.jpg",
    "startSec": 108.32,
    "text": "Solo que vive en otro continente."
  },
  {
    "file": "v3_1_50.jpg",
    "startSec": 110.28,
    "text": "Número 4."
  },
  {
    "file": "v3_1_51.jpg",
    "startSec": 111.38,
    "text": "Las 9."
  },
  {
    "file": "v3_1_52.jpg",
    "startSec": 112.34,
    "text": "Llegas al trabajo."
  },
  {
    "file": "v3_1_53.jpg",
    "startSec": 113.14,
    "text": "Tu agente de inteligencia artificial ya ha"
  },
  {
    "file": "v3_1_55.jpg",
    "startSec": 115.52,
    "text": "contestado los correos"
  },
  {
    "file": "v3_1_56.jpg",
    "startSec": 116.62,
    "text": "y te ha hecho el informe."
  },
  {
    "file": "v3_1_58.jpg",
    "startSec": 118.28,
    "text": "Lo ha medido el laboratorio M -E -T -R."
  },
  {
    "file": "v3_2_00.jpg",
    "startSec": 120.8,
    "text": "La duración de las tareas que una inteligencia artificial"
  },
  {
    "file": "v3_2_03.jpg",
    "startSec": 123.26,
    "text": "termina sola se duplica cada 7 meses"
  },
  {
    "file": "v3_2_05.jpg",
    "startSec": 125.54,
    "text": "y lleva así 6 años."
  },
  {
    "file": "v3_2_07.jpg",
    "startSec": 127.88,
    "text": "Pero sólo las afierta a la mitad de las veces."
  },
  {
    "file": "v3_2_10.jpg",
    "startSec": 130.48,
    "text": "La otra mitad hay que repasarla."
  },
  {
    "file": "v3_2_12.jpg",
    "startSec": 132.5,
    "text": "Tu compañero de mesa puede ser un programa"
  },
  {
    "file": "v3_2_14.jpg",
    "startSec": 134.44,
    "text": "y tú el que le corrí que los deberés."
  },
  {
    "file": "v3_2_17.jpg",
    "startSec": 137.08,
    "text": "Número 5."
  },
  {
    "file": "v3_2_18.jpg",
    "startSec": 138.24,
    "text": "La 11."
  },
  {
    "file": "v3_2_19.jpg",
    "startSec": 139.24,
    "text": "El médico."
  },
  {
    "file": "v3_2_20.jpg",
    "startSec": 140.18,
    "text": "Tu madre se hace una mamografía."
  },
  {
    "file": "v3_2_21.jpg",
    "startSec": 141.74,
    "text": "Y antes que el radiólogo"
  },
  {
    "file": "v3_2_23.jpg",
    "startSec": 143.24,
    "text": "la mira una inteligencia artificial."
  },
  {
    "file": "v3_2_25.jpg",
    "startSec": 145.44,
    "text": "En Suecia lo probaron con más de 100 .000 mujeres."
  },
  {
    "file": "v3_2_28.jpg",
    "startSec": 148.2,
    "text": "Encontraron un 29"
  },
  {
    "file": "v3_2_29.jpg",
    "startSec": 149.38,
    "text": "% más de cánceres"
  },
  {
    "file": "v3_2_30.jpg",
    "startSec": 150.78,
    "text": "y los radiólogos leyeron"
  },
  {
    "file": "v3_2_32.jpg",
    "startSec": 152.18,
    "text": "un 44 % menos."
  },
  {
    "file": "v3_2_34.jpg",
    "startSec": 154.18,
    "text": "Encontrar más cánceres"
  },
  {
    "file": "v3_2_35.jpg",
    "startSec": 155.44,
    "text": "todavía no demuestra que mueran"
  },
  {
    "file": "v3_2_36.jpg",
    "startSec": 156.82,
    "text": "menos personas y quien firma sigue siendo"
  },
  {
    "file": "v3_2_39.jpg",
    "startSec": 159.24,
    "text": "el médico."
  },
  {
    "file": "v3_2_40.jpg",
    "startSec": 160.2,
    "text": "Número 6."
  },
  {
    "file": "v3_2_41.jpg",
    "startSec": 161.36,
    "text": "La 1."
  },
  {
    "file": "v3_2_42.jpg",
    "startSec": 162.2,
    "text": "La compra."
  },
  {
    "file": "v3_2_43.jpg",
    "startSec": 163.1,
    "text": "Te has quedado sin leche."
  },
  {
    "file": "v3_2_44.jpg",
    "startSec": 164.68,
    "text": "Y un dron te la deja en el jardín."
  },
  {
    "file": "v3_2_46.jpg",
    "startSec": 166.8,
    "text": "Ya pasa en Texas."
  },
  {
    "file": "v3_2_47.jpg",
    "startSec": 167.62,
    "text": "Wing, también de Google,"
  },
  {
    "file": "v3_2_49.jpg",
    "startSec": 169.6,
    "text": "reparte con drones para los supermercados Walmart."
  },
  {
    "file": "v3_2_52.jpg",
    "startSec": 172.22,
    "text": "En 2017 quieren llegar"
  },
  {
    "file": "v3_2_53.jpg",
    "startSec": 173.78,
    "text": "a más de 40 millones de personas."
  },
  {
    "file": "v3_2_55.jpg",
    "startSec": 175.92,
    "text": "El problema es que cada dron carga poco más de 2"
  },
  {
    "file": "v3_2_58.jpg",
    "startSec": 178.24,
    "text": "kilos y en un piso de Madrid, donde"
  },
  {
    "file": "v3_3_00.jpg",
    "startSec": 180.3,
    "text": "aterrisa."
  },
  {
    "file": "v3_3_01.jpg",
    "startSec": 181.22,
    "text": "El repartidor del futuro vuela,"
  },
  {
    "file": "v3_3_03.jpg",
    "startSec": 183.28,
    "text": "pero necesita un patio."
  },
  {
    "file": "v3_3_04.jpg",
    "startSec": 184.94,
    "text": "A partir de aquí vienen las que más cuestan."
  },
  {
    "file": "v3_3_07.jpg",
    "startSec": 187.52,
    "text": "Número 7."
  },
  {
    "file": "v3_3_08.jpg",
    "startSec": 188.72,
    "text": "Las 4."
  },
  {
    "file": "v3_3_09.jpg",
    "startSec": 189.7,
    "text": "El café."
  },
  {
    "file": "v3_3_10.jpg",
    "startSec": 190.56,
    "text": "Lo pagas con euros digitales desde el móvil."
  },
  {
    "file": "v3_3_12.jpg",
    "startSec": 192.88,
    "text": "Hasta sin cobertura."
  },
  {
    "file": "v3_3_14.jpg",
    "startSec": 194.18,
    "text": "Esto ya tiene fecha."
  },
  {
    "file": "v3_3_15.jpg",
    "startSec": 195.24,
    "text": "El Banco Central Europeo"
  },
  {
    "file": "v3_3_16.jpg",
    "startSec": 196.76,
    "text": "quiere emitirlo en 2019."
  },
  {
    "file": "v3_3_18.jpg",
    "startSec": 198.82,
    "text": "En julio, el Parlamento Europeo"
  },
  {
    "file": "v3_3_20.jpg",
    "startSec": 200.62,
    "text": "votó a abrir la negociación."
  },
  {
    "file": "v3_3_22.jpg",
    "startSec": 202.26,
    "text": "Y el ponente es español, Fernando Navarrete."
  },
  {
    "file": "v3_3_25.jpg",
    "startSec": 205.06,
    "text": "Pero esa fecha exige a probar la ley este año."
  },
  {
    "file": "v3_3_27.jpg",
    "startSec": 207.64,
    "text": "Si la ley se retrasa, se retrasa todo."
  },
  {
    "file": "v3_3_30.jpg",
    "startSec": 210.14,
    "text": "Número 8."
  },
  {
    "file": "v3_3_31.jpg",
    "startSec": 211.28,
    "text": "Las 6."
  },
  {
    "file": "v3_3_32.jpg",
    "startSec": 212.3,
    "text": "Quedas con tus amigos."
  },
  {
    "file": "v3_3_33.jpg",
    "startSec": 213.8,
    "text": "Llevas gafas con pantalla."
  },
  {
    "file": "v3_3_35.jpg",
    "startSec": 215.3,
    "text": "Y contestas los mensajes moviendo los dedos."
  },
  {
    "file": "v3_3_37.jpg",
    "startSec": 217.76,
    "text": "Eso ya se vende."
  },
  {
    "file": "v3_3_39.jpg",
    "startSec": 219.04,
    "text": "Las gafas raivan con pantalla de meta."
  },
  {
    "file": "v3_3_41.jpg",
    "startSec": 221.14,
    "text": "Traen una pulsera que lee los gestos de tu mano."
  },
  {
    "file": "v3_3_43.jpg",
    "startSec": 223.22,
    "text": "En octubre de 2026"
  },
  {
    "file": "v3_3_44.jpg",
    "startSec": 224.94,
    "text": "llegaron a Alemania,"
  },
  {
    "file": "v3_3_46.jpg",
    "startSec": 226.26,
    "text": "Francia y Italia"
  },
  {
    "file": "v3_3_47.jpg",
    "startSec": 227.06,
    "text": "por 899 euros."
  },
  {
    "file": "v3_3_49.jpg",
    "startSec": 229.32,
    "text": "A España aún sin fecha."
  },
  {
    "file": "v3_3_51.jpg",
    "startSec": 231.22,
    "text": "A mí lo que me inquieta es otra cosa."
  },
  {
    "file": "v3_3_53.jpg",
    "startSec": 233.18,
    "text": "Una cámara en la cara de cada persona"
  },
  {
    "file": "v3_3_54.jpg",
    "startSec": 234.94,
    "text": "y una lucecita"
  },
  {
    "file": "v3_3_56.jpg",
    "startSec": 236.02,
    "text": "como unico aviso de que te graban."
  },
  {
    "file": "v3_3_58.jpg",
    "startSec": 238.14,
    "text": "Número 9."
  },
  {
    "file": "v3_3_59.jpg",
    "startSec": 239.24,
    "text": "Las 8."
  },
  {
    "file": "v3_4_00.jpg",
    "startSec": 240.28,
    "text": "Vuelves a casa."
  },
  {
    "file": "v3_4_01.jpg",
    "startSec": 241.38,
    "text": "Y un robot con forma de persona"
  },
  {
    "file": "v3_4_02.jpg",
    "startSec": 242.94,
    "text": "te ha doblado la ropa."
  },
  {
    "file": "v3_4_04.jpg",
    "startSec": 244.5,
    "text": "La empresa OneX vende"
  },
  {
    "file": "v3_4_05.jpg",
    "startSec": 245.78,
    "text": "su robotneo por 20 .000 dólares"
  },
  {
    "file": "v3_4_07.jpg",
    "startSec": 247.68,
    "text": "y promete entregarlo en Estados"
  },
  {
    "file": "v3_4_09.jpg",
    "startSec": 249.24,
    "text": "Unidos en 2026."
  },
  {
    "file": "v3_4_10.jpg",
    "startSec": 250.72,
    "text": "Lo raro es"
  },
  {
    "file": "v3_4_11.jpg",
    "startSec": 251.7,
    "text": "que cuando Neo no sabe hacer algo,"
  },
  {
    "file": "v3_4_13.jpg",
    "startSec": 253.82,
    "text": "lo maneja a distancia"
  },
  {
    "file": "v3_4_14.jpg",
    "startSec": 254.66,
    "text": "un empleado, viendo tu casa."
  },
  {
    "file": "v3_4_16.jpg",
    "startSec": 256.84,
    "text": "Que lo haga todo solo es dudoso."
  },
  {
    "file": "v3_4_18.jpg",
    "startSec": 258.68,
    "text": "El robot de casa ya existe,"
  },
  {
    "file": "v3_4_20.jpg",
    "startSec": 260.48,
    "text": "lo que le falta es aprender."
  },
  {
    "file": "v3_4_22.jpg",
    "startSec": 262.2,
    "text": "Número 10."
  },
  {
    "file": "v3_4_23.jpg",
    "startSec": 263.32,
    "text": "La 11 de la noche."
  },
  {
    "file": "v3_4_24.jpg",
    "startSec": 264.66,
    "text": "Ya en la cama."
  },
  {
    "file": "v3_4_25.jpg",
    "startSec": 265.7,
    "text": "Escribes un mensaje sin tocar el móvil."
  },
  {
    "file": "v3_4_28.jpg",
    "startSec": 268.02,
    "text": "Solo compensarlo."
  },
  {
    "file": "v3_4_29.jpg",
    "startSec": 269.34,
    "text": "Esto ya pasa en ensayos."
  },
  {
    "file": "v3_4_31.jpg",
    "startSec": 271.16,
    "text": "Neuralink, la empresa de Elon Musk implanta"
  },
  {
    "file": "v3_4_33.jpg",
    "startSec": 273.6,
    "text": "un chip en el cerebro de personas con paralisis."
  },
  {
    "file": "v3_4_35.jpg",
    "startSec": 275.76,
    "text": "En enero de este año ya eran 21"
  },
  {
    "file": "v3_4_37.jpg",
    "startSec": 277.96,
    "text": "personas y mueven"
  },
  {
    "file": "v3_4_39.jpg",
    "startSec": 279.46,
    "text": "un cursor con la mente."
  },
  {
    "file": "v3_4_40.jpg",
    "startSec": 280.98,
    "text": "Aunque al primer paciente se les saltaron"
  },
  {
    "file": "v3_4_42.jpg",
    "startSec": 282.66,
    "text": "parte de los hilos del implante."
  },
  {
    "file": "v3_4_44.jpg",
    "startSec": 284.42,
    "text": "Para alguien sano, todavía es dudoso,"
  },
  {
    "file": "v3_4_46.jpg",
    "startSec": 286.72,
    "text": "pero para quien no puede mover las manos,"
  },
  {
    "file": "v3_4_48.jpg",
    "startSec": 288.9,
    "text": "escribir con la mente ya es real."
  },
  {
    "file": "v3_4_51.jpg",
    "startSec": 291.16,
    "text": "Y ahora la pregunta del principio."
  },
  {
    "file": "v3_4_53.jpg",
    "startSec": 293.36,
    "text": "¿Cuál se saltó su fecha?"
  },
  {
    "file": "v3_4_54.jpg",
    "startSec": 294.9,
    "text": "El taxi sin conductor."
  },
  {
    "file": "v3_4_56.jpg",
    "startSec": 296.58,
    "text": "¿Pero el de Tesla?"
  },
  {
    "file": "v3_4_57.jpg",
    "startSec": 297.74,
    "text": "En 2019,"
  },
  {
    "file": "v3_4_59.jpg",
    "startSec": 299.02,
    "text": "Elon Musk prometió más de un millón"
  },
  {
    "file": "v3_5_00.jpg",
    "startSec": 300.66,
    "text": "de robotaxis para el año siguiente."
  },
  {
    "file": "v3_5_02.jpg",
    "startSec": 302.3,
    "text": "Al acabar 2025,"
  },
  {
    "file": "v3_5_04.jpg",
    "startSec": 304.3,
    "text": "en Austin circulaban unos 30."
  },
  {
    "file": "v3_5_06.jpg",
    "startSec": 306.24,
    "text": "Y lo curioso es que esa promesa fallida"
  },
  {
    "file": "v3_5_08.jpg",
    "startSec": 308.04,
    "text": "es de las que ya existen."
  },
  {
    "file": "v3_5_09.jpg",
    "startSec": 309.8,
    "text": "Weymoo la cumple cada semana."
  },
  {
    "file": "v3_5_11.jpg",
    "startSec": 311.62,
    "text": "¿Y tú?"
  },
  {
    "file": "v3_5_12.jpg",
    "startSec": 312.22,
    "text": "¿Cuál de las 10 crees que llega antes a España?"
  },
  {
    "file": "v3_5_14.jpg",
    "startSec": 314.58,
    "text": "Te leeré en los comentarios."
  },
  {
    "file": "v3_5_15.jpg",
    "startSec": 315.96,
    "text": "Si te gusta entender cómo funciona de verdad la tecnología"
  },
  {
    "file": "v3_5_18.jpg",
    "startSec": 318.36,
    "text": "que usas cada día, suscríbete."
  },
  {
    "file": "v3_5_20.jpg",
    "startSec": 320.5,
    "text": "Cada semana, una máquina,"
  },
  {
    "file": "v3_5_21.jpg",
    "startSec": 321.96,
    "text": "un invento o una idea explicada fácil."
  }
]