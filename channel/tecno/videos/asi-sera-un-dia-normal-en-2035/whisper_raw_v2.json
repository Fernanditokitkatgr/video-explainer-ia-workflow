[
  {
    "file": "0_00.jpg",
    "startSec": 0.0,
    "text": "son las 7 de la mañana"
  },
  {
    "file": "0_01.jpg",
    "startSec": 1.18,
    "text": "de un martes de 2035."
  },
  {
    "file": "0_03.jpg",
    "startSec": 3.52,
    "text": "Tu casa ya está calentita"
  },
  {
    "file": "0_04.jpg",
    "startSec": 4.92,
    "text": "y ya no tienes caldera."
  },
  {
    "file": "0_06.jpg",
    "startSec": 6.86,
    "text": "Abajo te espera un taxi,"
  },
  {
    "file": "0_08.jpg",
    "startSec": 8.68,
    "text": "sin nadie al volante."
  },
  {
    "file": "0_10.jpg",
    "startSec": 10.12,
    "text": "Suena a ciencia ficción, ¿verdad?"
  },
  {
    "file": "0_11.jpg",
    "startSec": 11.86,
    "text": "Pues las 10 cosas de este día"
  },
  {
    "file": "0_13.jpg",
    "startSec": 13.5,
    "text": "ya se están construyendo."
  },
  {
    "file": "0_15.jpg",
    "startSec": 15.34,
    "text": "Otra cosa es que lleguen todas."
  },
  {
    "file": "0_17.jpg",
    "startSec": 17.18,
    "text": "Algunas lo tienen muy difícil."
  },
  {
    "file": "0_19.jpg",
    "startSec": 19.1,
    "text": "Y una ya tuvo fecha para dentro de un año."
  },
  {
    "file": "0_21.jpg",
    "startSec": 21.92,
    "text": "De eso hace 7."
  },
  {
    "file": "0_23.jpg",
    "startSec": 23.38,
    "text": "¿A divinas cuál?"
  },
  {
    "file": "0_24.jpg",
    "startSec": 24.34,
    "text": "Empezamos a las 7, al despertar."
  },
  {
    "file": "0_26.jpg",
    "startSec": 26.62,
    "text": "El calor sale de una bomba de calor."
  },
  {
    "file": "0_28.jpg",
    "startSec": 28.44,
    "text": "Y la luz de las placas del tejado."
  },
  {
    "file": "0_30.jpg",
    "startSec": 30.78,
    "text": "Y ya es ley."
  },
  {
    "file": "0_31.jpg",
    "startSec": 31.9,
    "text": "Según la directiva europea de edificios,"
  },
  {
    "file": "0_33.jpg",
    "startSec": 33.94,
    "text": "desde 2030 todos los nuevos"
  },
  {
    "file": "0_35.jpg",
    "startSec": 35.78,
    "text": "serán de cero emisiones."
  },
  {
    "file": "0_37.jpg",
    "startSec": 37.46,
    "text": "Para 2040,"
  },
  {
    "file": "0_38.jpg",
    "startSec": 38.58,
    "text": "Europa quiere dejar de calentar"
  },
  {
    "file": "0_39.jpg",
    "startSec": 39.88,
    "text": "casas con gás y gasoleo."
  },
  {
    "file": "0_42.jpg",
    "startSec": 42.04,
    "text": "España tenía que adaptar la ley antes de junio,"
  },
  {
    "file": "0_44.jpg",
    "startSec": 44.78,
    "text": "y en mayo iba por 60%."
  },
  {
    "file": "0_46.jpg",
    "startSec": 46.84,
    "text": "La casa del futuro ya se construye."
  },
  {
    "file": "0_49.jpg",
    "startSec": 49.34,
    "text": "El piso de tu abuela sigue igual."
  },
  {
    "file": "0_51.jpg",
    "startSec": 51.24,
    "text": "A la 7 y media toca desayunar."
  },
  {
    "file": "0_53.jpg",
    "startSec": 53.26,
    "text": "Un taspate en la tostada."
  },
  {
    "file": "0_54.jpg",
    "startSec": 54.88,
    "text": "Y ese pato nunca existió."
  },
  {
    "file": "0_56.jpg",
    "startSec": 56.58,
    "text": "Salió de células cultivadas."
  },
  {
    "file": "0_57.jpg",
    "startSec": 57.84,
    "text": "Fuera ya se vende."
  },
  {
    "file": "0_59.jpg",
    "startSec": 59.52,
    "text": "Singapura provosta Carmen en 2020,"
  },
  {
    "file": "1_01.jpg",
    "startSec": 61.82,
    "text": "y Estados Unidos en 2023."
  },
  {
    "file": "1_04.jpg",
    "startSec": 64.06,
    "text": "Y en San Sebastián,"
  },
  {
    "file": "1_05.jpg",
    "startSec": 65.24,
    "text": "Biotech Foods empezó a construir una planta"
  },
  {
    "file": "1_07.jpg",
    "startSec": 67.3,
    "text": "para mil toneladas al año."
  },
  {
    "file": "1_09.jpg",
    "startSec": 69.12,
    "text": "¿La verás en tu super?"
  },
  {
    "file": "1_10.jpg",
    "startSec": 70.42,
    "text": "Lo tiene difícil."
  },
  {
    "file": "1_11.jpg",
    "startSec": 71.56,
    "text": "El problema es que en Italia"
  },
  {
    "file": "1_12.jpg",
    "startSec": 72.64,
    "text": "ya la han prohibido por ley."
  },
  {
    "file": "1_14.jpg",
    "startSec": 74.4,
    "text": "Y la Unión Europea todavía no ha probado ninguna."
  },
  {
    "file": "1_17.jpg",
    "startSec": 77.18,
    "text": "La carne del futuro ya existe."
  },
  {
    "file": "1_19.jpg",
    "startSec": 79.16,
    "text": "Lo difícil es que te dejen comprarla."
  },
  {
    "file": "1_21.jpg",
    "startSec": 81.24,
    "text": "La 8 y 4."
  },
  {
    "file": "1_22.jpg",
    "startSec": 82.38,
    "text": "¿Te vas al curro?"
  },
  {
    "file": "1_23.jpg",
    "startSec": 83.32,
    "text": "Te subes al taxi"
  },
  {
    "file": "1_24.jpg",
    "startSec": 84.22,
    "text": "y el volante gira solo."
  },
  {
    "file": "1_26.jpg",
    "startSec": 86.0,
    "text": "Ueymo, la empresa hermana de Google,"
  },
  {
    "file": "1_28.jpg",
    "startSec": 88.38,
    "text": "circula sin conductor en más de 10"
  },
  {
    "file": "1_30.jpg",
    "startSec": 90.04,
    "text": "ciudades de Estados Unidos."
  },
  {
    "file": "1_31.jpg",
    "startSec": 91.72,
    "text": "A principios de este año daba unos 500"
  },
  {
    "file": "1_33.jpg",
    "startSec": 93.66,
    "text": ".000 viajes de pago a la semana."
  },
  {
    "file": "1_35.jpg",
    "startSec": 95.74,
    "text": "En Europa lo prometen, empezando por Londres."
  },
  {
    "file": "1_38.jpg",
    "startSec": 98.54,
    "text": "Y en España,"
  },
  {
    "file": "1_39.jpg",
    "startSec": 99.98,
    "text": "Ueymo no ha dado ninguna fecha."
  },
  {
    "file": "1_41.jpg",
    "startSec": 101.82,
    "text": "El coche sin conductor ya existe,"
  },
  {
    "file": "1_43.jpg",
    "startSec": 103.92,
    "text": "solo que vive en otro continente."
  },
  {
    "file": "1_45.jpg",
    "startSec": 105.88,
    "text": "Alas nueve llegas al trabajo."
  },
  {
    "file": "1_47.jpg",
    "startSec": 107.74,
    "text": "Tu agente de inteligencia artificial"
  },
  {
    "file": "1_49.jpg",
    "startSec": 109.36,
    "text": "ya ha contestado los correos."
  },
  {
    "file": "1_51.jpg",
    "startSec": 111.12,
    "text": "Y te ha hecho el informe."
  },
  {
    "file": "1_52.jpg",
    "startSec": 112.36,
    "text": "¿Exagero?"
  },
  {
    "file": "1_53.jpg",
    "startSec": 113.12,
    "text": "El laboratorio METR lo ha medido."
  },
  {
    "file": "1_55.jpg",
    "startSec": 115.64,
    "text": "La duración de las tareas"
  },
  {
    "file": "1_57.jpg",
    "startSec": 117.06,
    "text": "que una inteligencia artificial termina sola"
  },
  {
    "file": "1_59.jpg",
    "startSec": 119.0,
    "text": "se duplica cada siete meses"
  },
  {
    "file": "2_00.jpg",
    "startSec": 120.72,
    "text": "y lleva así seis años."
  },
  {
    "file": "2_02.jpg",
    "startSec": 122.9,
    "text": "Es una promesa, pero la"
  },
  {
    "file": "2_04.jpg",
    "startSec": 124.3,
    "text": "tendencia les da la razón."
  },
  {
    "file": "2_06.jpg",
    "startSec": 126.06,
    "text": "Eso sí."
  },
  {
    "file": "2_07.jpg",
    "startSec": 126.98,
    "text": "Esas tareas las cierta la mitad de las veces."
  },
  {
    "file": "2_09.jpg",
    "startSec": 129.58,
    "text": "La otra mitad hay que repasarla."
  },
  {
    "file": "2_11.jpg",
    "startSec": 131.74,
    "text": "Tu compañero de mesa puede ser un programa."
  },
  {
    "file": "2_14.jpg",
    "startSec": 134.6,
    "text": "¿Y tú?"
  },
  {
    "file": "2_15.jpg",
    "startSec": 135.1,
    "text": "El que le corrije a los deberes."
  },
  {
    "file": "2_16.jpg",
    "startSec": 136.76,
    "text": "A la 11, tu madre tiene médico."
  },
  {
    "file": "2_18.jpg",
    "startSec": 138.96,
    "text": "Se hace una mamografía."
  },
  {
    "file": "2_20.jpg",
    "startSec": 140.48,
    "text": "Y antes que el radiólogo,"
  },
  {
    "file": "2_21.jpg",
    "startSec": 141.86,
    "text": "la mira a una inteligencia artificial."
  },
  {
    "file": "2_23.jpg",
    "startSec": 143.48,
    "text": "En suecía lo probaron"
  },
  {
    "file": "2_24.jpg",
    "startSec": 144.76,
    "text": "con más de 100 .000 mujeres."
  },
  {
    "file": "2_26.jpg",
    "startSec": 146.58,
    "text": "Encontraron un 29 %"
  },
  {
    "file": "2_28.jpg",
    "startSec": 148.1,
    "text": "más de cánceres."
  },
  {
    "file": "2_29.jpg",
    "startSec": 149.32,
    "text": "Y los radiólogos leyeron"
  },
  {
    "file": "2_30.jpg",
    "startSec": 150.5,
    "text": "un 44 % menos."
  },
  {
    "file": "2_32.jpg",
    "startSec": 152.44,
    "text": "Pero ojo, encontrar"
  },
  {
    "file": "2_33.jpg",
    "startSec": 153.78,
    "text": "más cánceres todavía no demuestra"
  },
  {
    "file": "2_35.jpg",
    "startSec": 155.56,
    "text": "que mueran menos personas."
  },
  {
    "file": "2_37.jpg",
    "startSec": 157.14,
    "text": "Y el que firma sigue siendo el médico."
  },
  {
    "file": "2_39.jpg",
    "startSec": 159.4,
    "text": "Es la una y te has quedado sin leche."
  },
  {
    "file": "2_41.jpg",
    "startSec": 161.42,
    "text": "Y un dron te la deja en el jardín."
  },
  {
    "file": "2_43.jpg",
    "startSec": 163.4,
    "text": "¿Ya pasa en Tejas?"
  },
  {
    "file": "2_44.jpg",
    "startSec": 164.86,
    "text": "Wing de la familia de Google"
  },
  {
    "file": "2_46.jpg",
    "startSec": 166.2,
    "text": "reparte con drones"
  },
  {
    "file": "2_47.jpg",
    "startSec": 167.4,
    "text": "para los supermercados Walmart."
  },
  {
    "file": "2_49.jpg",
    "startSec": 169.2,
    "text": "Y en dos mil veintisiete quieren"
  },
  {
    "file": "2_50.jpg",
    "startSec": 170.52,
    "text": "llegar a más de 40 millones"
  },
  {
    "file": "2_52.jpg",
    "startSec": 172.06,
    "text": "de personas."
  },
  {
    "file": "2_53.jpg",
    "startSec": 173.12,
    "text": "Lo malo."
  },
  {
    "file": "2_54.jpg",
    "startSec": 173.86,
    "text": "Cada drone carga a poco más de dos kilos."
  },
  {
    "file": "2_56.jpg",
    "startSec": 176.08,
    "text": "Y en un piso de Madrid, donde aterrisa."
  },
  {
    "file": "2_58.jpg",
    "startSec": 178.64,
    "text": "El Departidor del futuro vuela,"
  },
  {
    "file": "3_00.jpg",
    "startSec": 180.72,
    "text": "pero necesita un patio."
  },
  {
    "file": "3_02.jpg",
    "startSec": 182.38,
    "text": "Y ahora las que más cuestan."
  },
  {
    "file": "3_04.jpg",
    "startSec": 184.54,
    "text": "A las cuatro te tomas un café."
  },
  {
    "file": "3_06.jpg",
    "startSec": 186.32,
    "text": "Lo pagas con euros digitales, desde el móvil."
  },
  {
    "file": "3_08.jpg",
    "startSec": 188.92,
    "text": "Hasta sin cobertura."
  },
  {
    "file": "3_10.jpg",
    "startSec": 190.26,
    "text": "Esto ya tiene fecha."
  },
  {
    "file": "3_11.jpg",
    "startSec": 191.72,
    "text": "El Banco Central Europeo quiere emitirlo en el 2019."
  },
  {
    "file": "3_14.jpg",
    "startSec": 194.74,
    "text": "En julio, el Parlamento Europeo"
  },
  {
    "file": "3_16.jpg",
    "startSec": 196.48,
    "text": "votó a abrir la negociación."
  },
  {
    "file": "3_18.jpg",
    "startSec": 198.08,
    "text": "Y el ponente es español, Fernando Navarrete."
  },
  {
    "file": "3_20.jpg",
    "startSec": 200.36,
    "text": "El problema es que esa fecha"
  },
  {
    "file": "3_22.jpg",
    "startSec": 202.0,
    "text": "exige a probar la ley este año."
  },
  {
    "file": "3_23.jpg",
    "startSec": 203.94,
    "text": "Si se retrasa la ley, se retrasa todo."
  },
  {
    "file": "3_26.jpg",
    "startSec": 206.78,
    "text": "A las seis quedas con tus amigos."
  },
  {
    "file": "3_28.jpg",
    "startSec": 208.64,
    "text": "Llevas gafas con pantalla."
  },
  {
    "file": "3_30.jpg",
    "startSec": 210.16,
    "text": "Y con estas mensajes moviendo los dedos."
  },
  {
    "file": "3_32.jpg",
    "startSec": 212.48,
    "text": "Eso ya se vende."
  },
  {
    "file": "3_33.jpg",
    "startSec": 213.72,
    "text": "Las gafas reivan con pantalla de meta."
  },
  {
    "file": "3_35.jpg",
    "startSec": 215.84,
    "text": "Llevan una pulsera que lee los gestos de tu mano."
  },
  {
    "file": "3_38.jpg",
    "startSec": 218.18,
    "text": "En octubre de dos mil veintiséis llegaron a Alemania,"
  },
  {
    "file": "3_40.jpg",
    "startSec": 220.9,
    "text": "Francia y Italia por"
  },
  {
    "file": "3_42.jpg",
    "startSec": 222.14,
    "text": "899 euros."
  },
  {
    "file": "3_44.jpg",
    "startSec": 224.1,
    "text": "¿Y a España?"
  },
  {
    "file": "3_45.jpg",
    "startSec": 225.16,
    "text": "De momento sin fecha."
  },
  {
    "file": "3_46.jpg",
    "startSec": 226.74,
    "text": "Lo que inquieta es otra cosa."
  },
  {
    "file": "3_48.jpg",
    "startSec": 228.14,
    "text": "Una cámara en la cara de cada persona."
  },
  {
    "file": "3_50.jpg",
    "startSec": 230.86,
    "text": "Y una lucecita como unico aviso de que te graban."
  },
  {
    "file": "3_53.jpg",
    "startSec": 233.64,
    "text": "La pantalla del futuro ya va en tu nariz."
  },
  {
    "file": "3_56.jpg",
    "startSec": 236.04,
    "text": "A las ocho vuelves a casa."
  },
  {
    "file": "3_57.jpg",
    "startSec": 237.64,
    "text": "Y un robot con forma de persona"
  },
  {
    "file": "3_59.jpg",
    "startSec": 239.14,
    "text": "te ha doblado la ropa."
  },
  {
    "file": "4_00.jpg",
    "startSec": 240.5,
    "text": "La empresa OneX vende su robot"
  },
  {
    "file": "4_02.jpg",
    "startSec": 242.16,
    "text": "Neo por 20 mil dólares"
  },
  {
    "file": "4_03.jpg",
    "startSec": 243.62,
    "text": "y promete entregarlo en Estados"
  },
  {
    "file": "4_05.jpg",
    "startSec": 245.22,
    "text": "Unidos en dos mil veintiséis."
  },
  {
    "file": "4_07.jpg",
    "startSec": 247.04,
    "text": "Pero aquí viene lo raro."
  },
  {
    "file": "4_08.jpg",
    "startSec": 248.58,
    "text": "Cuando Neo no sabe hacer algo,"
  },
  {
    "file": "4_10.jpg",
    "startSec": 250.44,
    "text": "lo maneja a distancia un empleado,"
  },
  {
    "file": "4_12.jpg",
    "startSec": 252.4,
    "text": "viendo tu casa."
  },
  {
    "file": "4_13.jpg",
    "startSec": 253.62,
    "text": "Que lo haga todo solo."
  },
  {
    "file": "4_15.jpg",
    "startSec": 255.12,
    "text": "Eso ya es dudoso."
  },
  {
    "file": "4_16.jpg",
    "startSec": 256.2,
    "text": "Y tu intimidad queda"
  },
  {
    "file": "4_17.jpg",
    "startSec": 257.56,
    "text": "en manos de un desconocido."
  },
  {
    "file": "4_19.jpg",
    "startSec": 259.24,
    "text": "El robot de casa ya existe."
  },
  {
    "file": "4_21.jpg",
    "startSec": 261.0,
    "text": "Lo que le falta es aprender solo."
  },
  {
    "file": "4_22.jpg",
    "startSec": 262.88,
    "text": "11 de la noche."
  },
  {
    "file": "4_24.jpg",
    "startSec": 264.08,
    "text": "Ya en la cama."
  },
  {
    "file": "4_25.jpg",
    "startSec": 265.0,
    "text": "Escribes un mensaje sin tocar el móvil."
  },
  {
    "file": "4_27.jpg",
    "startSec": 267.46,
    "text": "Solo compensarlo."
  },
  {
    "file": "4_28.jpg",
    "startSec": 268.72,
    "text": "Ya pasa en ensayos."
  },
  {
    "file": "4_30.jpg",
    "startSec": 270.52,
    "text": "Neuralink, la empresa de Elon"
  },
  {
    "file": "4_31.jpg",
    "startSec": 271.96,
    "text": "Musk implanta un chip"
  },
  {
    "file": "4_33.jpg",
    "startSec": 273.3,
    "text": "en el cerebro de personas con paralisis."
  },
  {
    "file": "4_35.jpg",
    "startSec": 275.48,
    "text": "En enero de este año ya eran"
  },
  {
    "file": "4_36.jpg",
    "startSec": 276.86,
    "text": "21 personas"
  },
  {
    "file": "4_38.jpg",
    "startSec": 278.08,
    "text": "y muenen un cursor con la mente."
  },
  {
    "file": "4_40.jpg",
    "startSec": 280.42,
    "text": "Aunque al primer paciente se les saltaron parte"
  },
  {
    "file": "4_42.jpg",
    "startSec": 282.46,
    "text": "de los hilos del implante."
  },
  {
    "file": "4_43.jpg",
    "startSec": 283.64,
    "text": "Para alguien sano, todavía es dudoso."
  },
  {
    "file": "4_46.jpg",
    "startSec": 286.24,
    "text": "Escribir con la mente ya es real."
  },
  {
    "file": "4_48.jpg",
    "startSec": 288.76,
    "text": "Para quien no puede mover las manos."
  },
  {
    "file": "4_50.jpg",
    "startSec": 290.9,
    "text": "Y ahora la pregunta del principio."
  },
  {
    "file": "4_53.jpg",
    "startSec": 293.3,
    "text": "¿Cuál se salca su fecha?"
  },
  {
    "file": "4_54.jpg",
    "startSec": 294.84,
    "text": "El taxi sin conductor."
  },
  {
    "file": "4_56.jpg",
