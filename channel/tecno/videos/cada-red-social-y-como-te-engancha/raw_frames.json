[
  {
    "file": "v3_0_00.jpg",
    "startSec": 0.0,
    "text": "Son las dos de la mañana,"
  },
  {
    "file": "v3_0_01.jpg",
    "startSec": 1.94,
    "text": "y llevas una hora en TikTok,"
  },
  {
    "file": "v3_0_04.jpg",
    "startSec": 4.04,
    "text": "solo iba a saber un vídeo,"
  },
  {
    "file": "v3_0_05.jpg",
    "startSec": 5.64,
    "text": "y tu pulgar sigue bajando."
  },
  {
    "file": "v3_0_07.jpg",
    "startSec": 7.48,
    "text": "Esculpa tuya, solo en parte,"
  },
  {
    "file": "v3_0_09.jpg",
    "startSec": 9.52,
    "text": "ese gesto lo diseñó alguien,"
  },
  {
    "file": "v3_0_11.jpg",
    "startSec": 11.22,
    "text": "y cada red social tiene su propio amfuelo."
  },
  {
    "file": "v3_0_13.jpg",
    "startSec": 13.82,
    "text": "La última, además,"
  },
  {
    "file": "v3_0_14.jpg",
    "startSec": 14.86,
    "text": "nació para curarte de todas las demás,"
  },
  {
    "file": "v3_0_17.jpg",
    "startSec": 17.04,
    "text": "adivinas que Truco acabó usando?"
  },
  {
    "file": "v3_0_18.jpg",
    "startSec": 18.88,
    "text": "Estas son las diez redes"
  },
  {
    "file": "v3_0_20.jpg",
    "startSec": 20.18,
    "text": "y su truco para engancharte,"
  },
  {
    "file": "v3_0_22.jpg",
    "startSec": 22.02,
    "text": "de la que más usas a la más sorprendente."
  },
  {
    "file": "v3_0_24.jpg",
    "startSec": 24.08,
    "text": "Número uno,"
  },
  {
    "file": "v3_0_25.jpg",
    "startSec": 25.56,
    "text": "Whatsapp, el chivato."
  },
  {
    "file": "v3_0_27.jpg",
    "startSec": 27.3,
    "text": "La crearon ya en CUMY Brian Acton en 2009."
  },
  {
    "file": "v3_0_30.jpg",
    "startSec": 30.2,
    "text": "Ese año Facebook había rechazado Acton."
  },
  {
    "file": "v3_0_32.jpg",
    "startSec": 32.52,
    "text": "5 años después se la compró"
  },
  {
    "file": "v3_0_34.jpg",
    "startSec": 34.1,
    "text": "por 19 .000 millones de dólares."
  },
  {
    "file": "v3_0_36.jpg",
    "startSec": 36.66,
    "text": "Su anzuelo es el doble checa azul."
  },
  {
    "file": "v3_0_38.jpg",
    "startSec": 38.72,
    "text": "Sabes que te han leído,"
  },
  {
    "file": "v3_0_39.jpg",
    "startSec": 39.96,
    "text": "y nadie quiere dejar a nadie en visto."
  },
  {
    "file": "v3_0_42.jpg",
    "startSec": 42.1,
    "text": "En España es la red favorita de casi"
  },
  {
    "file": "v3_0_43.jpg",
    "startSec": 43.76,
    "text": "cuatro de cada diez usuarios,"
  },
  {
    "file": "v3_0_45.jpg",
    "startSec": 45.56,
    "text": "según IAB Spain."
  },
  {
    "file": "v3_0_47.jpg",
    "startSec": 47.0,
    "text": "Quita las confirmaciones de lectura."
  },
  {
    "file": "v3_0_48.jpg",
    "startSec": 48.82,
    "text": "Whatsapp no te obliga a contestar,"
  },
  {
    "file": "v3_0_50.jpg",
    "startSec": 50.8,
    "text": "solo chiva que ya lo has leído."
  },
  {
    "file": "v3_0_52.jpg",
    "startSec": 52.3,
    "text": "Número dos, Youtube,"
  },
  {
    "file": "v3_0_54.jpg",
    "startSec": 54.46,
    "text": "la tele sin final."
  },
  {
    "file": "v3_0_55.jpg",
    "startSec": 55.74,
    "text": "Nación 2005,"
  },
  {
    "file": "v3_0_57.jpg",
    "startSec": 57.24,
    "text": "y al principio iba a ser una web de citas en vídeo."
  },
  {
    "file": "v3_0_59.jpg",
    "startSec": 59.88,
    "text": "Su anzuelo es la reproducción automática."
  },
  {
    "file": "v3_1_02.jpg",
    "startSec": 62.24,
    "text": "Acaba un vídeo, y empieza otro."
  },
  {
    "file": "v3_1_04.jpg",
    "startSec": 64.18,
    "text": "Tú nunca decides seguir."
  },
  {
    "file": "v3_1_05.jpg",
    "startSec": 65.76,
    "text": "Tendrías que decidir parar."
  },
  {
    "file": "v3_1_07.jpg",
    "startSec": 67.5,
    "text": "En 2018 lo contó Neil Mohan,"
  },
  {
    "file": "v3_1_09.jpg",
    "startSec": 69.62,
    "text": "su director de producto."
  },
  {
    "file": "v3_1_10.jpg",
    "startSec": 70.96,
    "text": "Más del 70 % de lo que se ve,"
  },
  {
    "file": "v3_1_13.jpg",
    "startSec": 73.16,
    "text": "sale de sus recomendaciones."
  },
  {
    "file": "v3_1_14.jpg",
    "startSec": 74.7,
    "text": "Así que apágalá."
  },
  {
    "file": "v3_1_15.jpg",
    "startSec": 75.94,
    "text": "Youtube nunca te pide que te quedes."
  },
  {
    "file": "v3_1_17.jpg",
    "startSec": 77.74,
    "text": "Simplemente, nunca se acaba."
  },
  {
    "file": "v3_1_19.jpg",
    "startSec": 79.28,
    "text": "Número tres,"
  },
  {
    "file": "v3_1_20.jpg",
    "startSec": 80.76,
    "text": "Instagram, el espejo."
  },
  {
    "file": "v3_1_22.jpg",
    "startSec": 82.64,
    "text": "La crearon Kevin Sistrom"
  },
  {
    "file": "v3_1_23.jpg",
    "startSec": 83.88,
    "text": "y Mike Krieger en 2010."
  },
  {
    "file": "v3_1_25.jpg",
    "startSec": 85.64,
    "text": "Su primera foto fue un perro junto a un puesto de tacos."
  },
  {
    "file": "v3_1_28.jpg",
    "startSec": 88.46,
    "text": "Su anzuelo es el contador de me gusta,"
  },
  {
    "file": "v3_1_30.jpg",
    "startSec": 90.6,
    "text": "debajo de cada foto."
  },
  {
    "file": "v3_1_31.jpg",
    "startSec": 91.84,
    "text": "En 2021 se filtró"
  },
  {
    "file": "v3_1_33.jpg",
    "startSec": 93.28,
    "text": "una investigación interna de Facebook."
  },
  {
    "file": "v3_1_35.jpg",
    "startSec": 95.26,
    "text": "Entre las chicas que ya se sentían mal con su cuerpo,"
  },
  {
    "file": "v3_1_37.jpg",
    "startSec": 97.94,
    "text": "una de cada tres se sentía"
  },
  {
    "file": "v3_1_39.jpg",
    "startSec": 99.4,
    "text": "peor por Instagram."
  },
  {
    "file": "v3_1_40.jpg",
    "startSec": 100.84,
    "text": "Oculta a los me gusta."
  },
  {
    "file": "v3_1_42.jpg",
    "startSec": 102.24,
    "text": "Instagram te enseña la vida"
  },
  {
    "file": "v3_1_43.jpg",
    "startSec": 103.42,
    "text": "de los demás, con la nota apuesta."
  },
  {
    "file": "v3_1_45.jpg",
    "startSec": 105.12,
    "text": "Número cuatro, TikTok,"
  },
  {
    "file": "v3_1_47.jpg",
    "startSec": 107.46,
    "text": "el pozo sin fondo."
  },
  {
    "file": "v3_1_48.jpg",
    "startSec": 108.86,
    "text": "Es de la China Bydance que en 2018"
  },
  {
    "file": "v3_1_50.jpg",
    "startSec": 110.86,
    "text": "la fusionó con musical puntoli."
  },
  {
    "file": "v3_1_53.jpg",
    "startSec": 113.08,
    "text": "Su anzuelo es el scroll infinito."
  },
  {
    "file": "v3_1_55.jpg",
    "startSec": 115.12,
    "text": "Lo inventó a Zarraskin en 2006"
  },
  {
    "file": "v3_1_56.jpg",
    "startSec": 116.86,
    "text": "y hoy dice que sea repiente."
  },
  {
    "file": "v3_1_58.jpg",
    "startSec": 118.88,
    "text": "Y el fit para ti aprende de cada segundo."
  },
  {
    "file": "v3_2_01.jpg",
    "startSec": 121.74,
    "text": "En Kentucky se filtraron sus documentos internos."
  },
  {
    "file": "v3_2_04.jpg",
    "startSec": 124.48,
    "text": "Según su propia investigación,"
  },
  {
    "file": "v3_2_06.jpg",
    "startSec": 126.04,
    "text": "el hábito puede empezar tras"
  },
  {
    "file": "v3_2_07.jpg",
    "startSec": 127.24,
    "text": "260 vídeos."
  },
  {
    "file": "v3_2_08.jpg",
    "startSec": 128.84,
    "text": "Unos 35 minutos."
  },
  {
    "file": "v3_2_11.jpg",
    "startSec": 131.06,
    "text": "Y en 2016 Bruselas acusó"
  },
  {
    "file": "v3_2_13.jpg",
    "startSec": 133.34,
    "text": "a su diseño adictivo"
  },
  {
    "file": "v3_2_14.jpg",
    "startSec": 134.34,
    "text": "de incumplir la ley europea."
  },
  {
    "file": "v3_2_16.jpg",
    "startSec": 136.28,
    "text": "Ponte un límite de tiempo en el móvil"
  },
  {
    "file": "v3_2_17.jpg",
    "startSec": 137.76,
    "text": "y que el código lo ponga otra persona."
  },
  {
    "file": "v3_2_20.jpg",
    "startSec": 140.44,
    "text": "Número cinco, Facebook, el confeso."
  },
  {
    "file": "v3_2_23.jpg",
    "startSec": 143.42,
    "text": "Antes, Mark Zuckerberg montó FaceMash,"
  },
  {
    "file": "v3_2_25.jpg",
    "startSec": 145.92,
    "text": "una web para votar quién era más guapo en Harvard."
  },
  {
    "file": "v3_2_28.jpg",
    "startSec": 148.66,
    "text": "Su anzuelo es el botón de me gusta."
  },
  {
    "file": "v3_2_30.jpg",
    "startSec": 150.66,
    "text": "Y su cocreador, Justin Rosenstein,"
  },
  {
    "file": "v3_2_32.jpg",
    "startSec": 152.9,
    "text": "acabó con control parental en su móvil."
  },
  {
    "file": "v3_2_34.jpg",
    "startSec": 154.82,
    "text": "En 2017,"
  },
  {
    "file": "v3_2_36.jpg",
    "startSec": 156.38,
    "text": "Sean Parker, su primer presidente,"
  },
  {
    "file": "v3_2_38.jpg",
    "startSec": 158.22,
    "text": "lo admitió en público."
  },
  {
    "file": "v3_2_39.jpg",
    "startSec": 159.56,
    "text": "Facebook explotaba una vulnerabilidad"
  },
  {
    "file": "v3_2_41.jpg",
    "startSec": 161.4,
    "text": "de la psicología humana."
  },
  {
    "file": "v3_2_42.jpg",
    "startSec": 162.8,
    "text": "Lo sabían y lo hicieron igual."
  },
  {
    "file": "v3_2_44.jpg",
    "startSec": 164.98,
    "text": "Apaga los avisos de me gusta y comentarios."
  },
  {
    "file": "v3_2_47.jpg",
    "startSec": 167.36,
    "text": "Te dan un poquito de aprobación"
  },
  {
    "file": "v3_2_48.jpg",
    "startSec": 168.72,
    "text": "y te dejan con ganas de más."
  },
  {
    "file": "v3_2_50.jpg",
    "startSec": 170.76,
    "text": "Número seis, X,"
  },
  {
    "file": "v3_2_52.jpg",
    "startSec": 172.54,
    "text": "antes Twitter, la Traga Perras."
  },
  {
    "file": "v3_2_54.jpg",
    "startSec": 174.64,
    "text": "Su primer Twitter lo escribió Jack Dorsey"
  },
  {
    "file": "v3_2_56.jpg",
    "startSec": 176.52,
    "text": "en 2006 y se vendió"
  },
  {
    "file": "v3_2_58.jpg",
    "startSec": 178.12,
    "text": "como NFT por casi"
  },
  {
    "file": "v3_2_59.jpg",
    "startSec": 179.4,
    "text": "tres millones de dólares."
  },
  {
    "file": "v3_3_00.jpg",
    "startSec": 180.86,
    "text": "Su anzuelo es tirar"
  },
  {
    "file": "v3_3_02.jpg",
    "startSec": 182.26,
    "text": "hacia abajo para actualizar."
  },
  {
    "file": "v3_3_03.jpg",
    "startSec": 183.84,
    "text": "Lo inventó Lauren Brickter y hoy"
  },
  {
    "file": "v3_3_05.jpg",
    "startSec": 185.66,
    "text": "reconoce que es adictivo."
  },
  {
    "file": "v3_3_07.jpg",
    "startSec": 187.42,
    "text": "Tiras, esperas"
  },
  {
    "file": "v3_3_08.jpg",
    "startSec": 188.56,
    "text": "y a veces sale algo nuevo,"
  },
  {
    "file": "v3_3_10.jpg",
    "startSec": 190.38,
    "text": "como una Traga Perras."
  },
  {
    "file": "v3_3_11.jpg",
    "startSec": 191.7,
    "text": "En diciembre de 2025,"
  },
  {
    "file": "v3_3_13.jpg",
    "startSec": 193.62,
    "text": "Bruselas multó a X"
  },
  {
    "file": "v3_3_14.jpg",
    "startSec": 194.54,
    "text": "con 120 millones de euros"
  },
  {
    "file": "v3_3_16.jpg",
    "startSec": 196.26,
    "text": "porque su check azul engañaba,"
  },
  {
    "file": "v3_3_18.jpg",
    "startSec": 198.58,
    "text": "usa la pestaña siguiendo."
  },
  {
    "file": "v3_3_20.jpg",
    "startSec": 200.18,
    "text": "Cada vez que tiras puede tocarte"
  },
  {
    "file": "v3_3_21.jpg",
    "startSec": 201.6,
    "text": "el premio y casi nunca toca."
  },
  {
    "file": "v3_3_23.jpg",
    "startSec": 203.7,
    "text": "Y ahora vienen las sorprendentes."
  },
  {
    "file": "v3_3_25.jpg",
    "startSec": 205.94,
    "text": "Número siete, Twitch,"
  },
  {
    "file": "v3_3_27.jpg",
    "startSec": 207.72,
    "text": "la que te paga por mirar."
  },
  {
    "file": "v3_3_29.jpg",
    "startSec": 209.04,
    "text": "Empezó en 2007"
  },
  {
    "file": "v3_3_30.jpg",
    "startSec": 210.22,
    "text": "cuando Justin Khan se puso"
  },
  {
    "file": "v3_3_31.jpg",
    "startSec": 211.82,
    "text": "una cámara en la cabeza y emitió"
  },
  {
    "file": "v3_3_33.jpg",
    "startSec": 213.42,
    "text": "su vida en directo."
  },
  {
    "file": "v3_3_34.jpg",
    "startSec": 214.6,
    "text": "Su anzuelos son los puntos de canal."
  },
  {
    "file": "v3_3_36.jpg",
    "startSec": 216.66,
    "text": "Cuanto más miras, más ganas."
  },
  {
    "file": "v3_3_38.jpg",
    "startSec": 218.64,
    "text": "Y si te vas del directo, te lo pierdes."
  },
  {
    "file": "v3_3_40.jpg",
    "startSec": 220.96,
    "text": "En 2025,"
  },
  {
    "file": "v3_3_42.jpg",
    "startSec": 222.2,
    "text": "la velada del año de Ibai superó"
  },
  {
    "file": "v3_3_43.jpg",
    "startSec": 223.82,
    "text": "los nueve millones de espectadores a la vez."
  },
  {
    "file": "v3_3_46.jpg",
    "startSec": 226.32,
    "text": "Decide antes a qué hora apagas."
  },
  {
    "file": "v3_3_48.jpg",
    "startSec": 228.26,
    "text": "Twitch te paga en puntos"
  },
  {
    "file": "v3_3_49.jpg",
    "startSec": 229.42,
    "text": "y tú le pagas en horas."
  },
  {
    "file": "v3_3_51.jpg",
    "startSec": 231.42,
    "text": "Número ocho, Snapchat,"
  },
  {
    "file": "v3_3_53.jpg",
    "startSec": 233.4,
    "text": "la de las rachas."
  },
  {
    "file": "v3_3_54.jpg",
    "startSec": 234.52,
    "text": "Naciones están foren 2011 con otro nombre."
  },
  {
    "file": "v3_3_56.jpg",
    "startSec": 236.68,
    "text": "La racha"
  },
  {
    "file": "v3_3_57.jpg",
    "startSec": 237.98,
    "text": "es un fuego con un número."
  },
  {
    "file": "v3_3_59.jpg",
    "startSec": 239.64,
    "text": "Sube cada día que tú"
  },
  {
    "file": "v3_4_00.jpg",
    "startSec": 240.78,
    "text": "y un amigo os mandáis una foto."
  },
  {
    "file": "v3_4_02.jpg",
    "startSec": 242.58,
    "text": "Si fallas un día, vuelve a cero."
  },
  {
    "file": "v3_4_04.jpg",
    "startSec": 244.58,
    "text": "En una demanda de nuevo México"
  },
  {
    "file": "v3_4_05.jpg",
    "startSec": 245.8,
    "text": "salió una presentación interna."
  },
  {
    "file": "v3_4_07.jpg",
    "startSec": 247.78,
    "text": "Decía que las rachas hacen imposible"
  },
  {
    "file": "v3_4_09.jpg",
    "startSec": 249.68,
    "text": "desconectar ni un solo día."
  },
  {
    "file": "v3_4_11.jpg",
    "startSec": 251.64,
    "text": "Pacta con tu amigo, romperla, tu amistad,"
  },
  {
    "file": "v3_4_14.jpg",
    "startSec": 254.08,
    "text": "con contador y caduca"
  },
  {
    "file": "v3_4_15.jpg",
    "startSec": 255.44,
    "text": "cada 24 horas."
  },
  {
    "file": "v3_4_16.jpg",
    "startSec": 256.98,
    "text": "Número nueve, Reddit,"
  },
  {
    "file": "v3_4_18.jpg",
    "startSec": 258.86,
    "text": "el pueblo de mentira."
  },
  {
    "file": "v3_4_20.jpg",
    "startSec": 260.18,
    "text": "Al principio estaba vacía,"
  },
  {
    "file": "v3_4_21.jpg",
    "startSec": 261.88,
    "text": "así que sus fundadores crearon"
  },
  {
    "file": "v3_4_23.jpg",
    "startSec": 263.36,
    "text": "cientos de cuentas falsas."
  },
  {
    "file": "v3_4_24.jpg",
    "startSec": 264.86,
    "text": "Su anzuelos son los votos."
  },
  {
    "file": "v3_4_26.jpg",
    "startSec": 266.8,
    "text": "Cada comentario tuyo lleva"
  },
  {
    "file": "v3_4_28.jpg",
    "startSec": 268.0,
    "text": "un marcador que sube o baja."
  },
  {
    "file": "v3_4_30.jpg",
    "startSec": 270.0,
    "text": "Y lo que escribes vale dinero."
  },
  {
    "file": "v3_4_31.jpg",
    "startSec": 271.98,
    "text": "Según Reuters, Google"
  },
  {
    "file": "v3_4_33.jpg",
    "startSec": 273.22,
    "text": "le paga unos 60 millones"
  },
  {
    "file": "v3_4_34.jpg",
    "startSec": 274.72,
    "text": "de dólares al año para entrenar"
  },
  {
    "file": "v3_4_36.jpg",
    "startSec": 276.32,
    "text": "su inteligencia artificial."
  },
  {
    "file": "v3_4_37.jpg",
    "startSec": 277.84,
    "text": "Quita los avisos de votos."
  },
  {
    "file": "v3_4_39.jpg",
    "startSec": 279.44,
    "text": "Reddit empezó con gente inventada."
  },
  {
    "file": "v3_4_41.jpg",
    "startSec": 281.38,
    "text": "Y hoy vende lo que escribe la gente de verdad."
  },
  {
    "file": "v3_4_43.jpg",
    "startSec": 283.86,
    "text": "Y la última, la más sorprendente."
  },
  {
    "file": "v3_4_46.jpg",
    "startSec": 286.3,
    "text": "Número 10, Virreal, la alarma."
  },
  {
    "file": "v3_4_49.jpg",
    "startSec": 289.08,
    "text": "La creó en Francia Alexis Barriatt"
  },
  {
    "file": "v3_4_50.jpg",
    "startSec": 290.78,
    "text": "en 2020 contra Instagram."
  },
  {
    "file": "v3_4_52.jpg",
    "startSec": 292.56,
    "text": "Fotos tal cual,"
  },
  {
    "file": "v3_4_54.jpg",
    "startSec": 294.14,
    "text": "y solo para tus amigos."
  },
  {
    "file": "v3_4_55.jpg",
    "startSec": 295.64,
    "text": "¿Y qué truco acabó usando?"
  },
  {
    "file": "v3_4_57.jpg",
    "startSec": 297.42,
    "text": "Una notificación, una vez al día."
  },
  {
    "file": "v3_4_59.jpg",
    "startSec": 299.68,
    "text": "A una hora que nunca sabes,"
  },
  {
    "file": "v3_5_01.jpg",
    "startSec": 301.46,
    "text": "tienes dos minutos para hacer la foto."
  },
  {
    "file": "v3_5_03.jpg",
    "startSec": 303.82,
    "text": "Y si llega tarde, todos lo ven."
  },
  {
    "file": "v3_5_06.jpg",
    "startSec": 306.16,
    "text": "Según platformer,"
  },
  {
    "file": "v3_5_07.jpg",
    "startSec": 307.26,
    "text": "en cinco meses pasó de 15 millones"
  },
  {
    "file": "v3_5_08.jpg",
    "startSec": 308.9,
    "text": "de usuarios al mes a seis."
  },
  {
    "file": "v3_5_11.jpg",
    "startSec": 311.06,
    "text": "Ninguna alarma de una AP es una emergencia."
  },
  {
    "file": "v3_5_13.jpg",
    "startSec": 313.62,
    "text": "Virreal te prometía soltar el móvil"
  },
  {
    "file": "v3_5_15.jpg",
    "startSec": 315.34,
    "text": "y te lo hacías sacar corriendo cada día."
  },
  {
    "file": "v3_5_17.jpg",
    "startSec": 317.74,
    "text": "¿Y tú? ¿Cuál de las diez te"
  },
  {
    "file": "v3_5_19.jpg",
    "startSec": 319.16,
    "text": "tiene despierto a las dos de la mañana?"
  },
  {
    "file": "v3_5_20.jpg",
    "startSec": 320.64,
    "text": "Te leo en los comentarios."
  },
  {
    "file": "v3_5_22.jpg",
    "startSec": 322.46,
    "text": "Si te gusta entender cómo funciona de verdad"
  },
  {
    "file": "v3_5_24.jpg",
    "startSec": 324.52,
    "text": "la tecnología que usas"
  },
  {
    "file": "v3_5_25.jpg",
    "startSec": 325.76,
    "text": "cada día, suscríbete."
  }
]