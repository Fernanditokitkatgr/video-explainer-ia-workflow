[
  {
    "file": "0_00.jpg",
    "startSec": 0.0,
    "text": "Lones, las doce y treinta y tres del medio día, estás en casa."
  },
  {
    "file": "0_04.jpg",
    "startSec": 4.52,
    "text": "Se apaga la nevera,"
  },
  {
    "file": "0_06.jpg",
    "startSec": 6.06,
    "text": "se apaga el router,"
  },
  {
    "file": "0_07.jpg",
    "startSec": 7.48,
    "text": "y el móvil se queda sin datos."
  },
  {
    "file": "0_09.jpg",
    "startSec": 9.54,
    "text": "No es tu casa,"
  },
  {
    "file": "0_11.jpg",
    "startSec": 11.02,
    "text": "es España entera y Portugal."
  },
  {
    "file": "0_14.jpg",
    "startSec": 14.24,
    "text": "¿Es el peor apagón de la historia?"
  },
  {
    "file": "0_16.jpg",
    "startSec": 16.34,
    "text": "No,"
  },
  {
    "file": "0_17.jpg",
    "startSec": 17.0,
    "text": "ni se le acerca."
  },
  {
    "file": "0_18.jpg",
    "startSec": 18.7,
    "text": "Aquí van diez, de los más famosos a los más grandes,"
  },
  {
    "file": "0_22.jpg",
    "startSec": 22.0,
    "text": "y los dos últimos llegaron del espacio,"
  },
  {
    "file": "0_24.jpg",
    "startSec": 24.3,
    "text": "y al final la pregunta de ese día,"
  },
  {
    "file": "0_26.jpg",
    "startSec": 26.6,
    "text": "¿qué apagó España?"
  },
  {
    "file": "0_28.jpg",
    "startSec": 28.5,
    "text": "Número uno,"
  },
  {
    "file": "0_29.jpg",
    "startSec": 29.7,
    "text": "Nueva York,"
  },
  {
    "file": "0_30.jpg",
    "startSec": 30.54,
    "text": "1977,"
  },
  {
    "file": "0_32.jpg",
    "startSec": 32.4,
    "text": "el apagón de los saqueos."
  },
  {
    "file": "0_34.jpg",
    "startSec": 34.34,
    "text": "Trece de julio por la noche,"
  },
  {
    "file": "0_36.jpg",
    "startSec": 36.14,
    "text": "caen rayos sobre las líneas que alimentan la ciudad,"
  },
  {
    "file": "0_38.jpg",
    "startSec": 38.8,
    "text": "y en una hora todo se queda oscuras,"
  },
  {
    "file": "0_41.jpg",
    "startSec": 41.28,
    "text": "9 millones de personas,"
  },
  {
    "file": "0_43.jpg",
    "startSec": 43.16,
    "text": "unas 25 horas sin luz,"
  },
  {
    "file": "0_45.jpg",
    "startSec": 45.42,
    "text": "saquearon o destrozaron 1 .616 tiendas y hubo más de 1 .000 incendios."
  },
  {
    "file": "0_50.jpg",
    "startSec": 50.9,
    "text": "¿Qué hacer?"
  },
  {
    "file": "0_51.jpg",
    "startSec": 51.96,
    "text": "Ten una linterna en un cajón que sepas encontrar a oscuras, su estilo,"
  },
  {
    "file": "0_56.jpg",
    "startSec": 56.26,
    "text": "lo empezó un rayo y lo terminaron las personas."
  },
  {
    "file": "1_00.jpg",
    "startSec": 60.3,
    "text": "Número dos, Noreste de Estados Unidos,"
  },
  {
    "file": "1_02.jpg",
    "startSec": 62.8,
    "text": "2003,"
  },
  {
    "file": "1_03.jpg",
    "startSec": 63.96,
    "text": "el apagón del bujo."
  },
  {
    "file": "1_05.jpg",
    "startSec": 65.52,
    "text": "14 de agosto,"
  },
  {
    "file": "1_06.jpg",
    "startSec": 66.8,
    "text": "50 millones de personas sin luz,"
  },
  {
    "file": "1_09.jpg",
    "startSec": 69.14,
    "text": "8 estados y ontario."
  },
  {
    "file": "1_11.jpg",
    "startSec": 71.0,
    "text": "Empezó en Ohio,"
  },
  {
    "file": "1_12.jpg",
    "startSec": 72.44,
    "text": "unas líneas tocaron árboles sin podar y saltaron,"
  },
  {
    "file": "1_15.jpg",
    "startSec": 75.62,
    "text": "pero la alarma de la sala de control se había quedado colgada y nadie lo sabía."
  },
  {
    "file": "1_20.jpg",
    "startSec": 80.38,
    "text": "Semanas después encontraron el fallo, un bujo. Dos procesos escribiendo a la vez en el mismo dato."
  },
  {
    "file": "1_26.jpg",
    "startSec": 86.56,
    "text": "Su estilo,"
  },
  {
    "file": "1_27.jpg",
    "startSec": 87.54,
    "text": "lo tumbó un árbol y lo agravo una alarma muda."
  },
  {
    "file": "1_31.jpg",
    "startSec": 91.58,
    "text": "Número tres, Italia,"
  },
  {
    "file": "1_33.jpg",
    "startSec": 93.2,
    "text": "2003,"
  },
  {
    "file": "1_34.jpg",
    "startSec": 94.28,
    "text": "el árbol suizo."
  },
  {
    "file": "1_35.jpg",
    "startSec": 95.78,
    "text": "Las tres de la madrugada, en suiza una línea que lleva electricidad a Italia, roza un árbol y se desconecta."
  },
  {
    "file": "1_42.jpg",
    "startSec": 102.8,
    "text": "Las demás se sobrecargan y en menos de media hora se apaga a Italia entera."
  },
  {
    "file": "1_47.jpg",
    "startSec": 107.98,
    "text": "56 millones de personas hasta 12 horas sin luz"
  },
  {
    "file": "1_51.jpg",
    "startSec": 111.96,
    "text": "y pilló a Roma de fiesta era su primera noche blanca."
  },
  {
    "file": "1_55.jpg",
    "startSec": 115.88,
    "text": "Su estilo,"
  },
  {
    "file": "1_57.jpg",
    "startSec": 117.02,
    "text": "un solo árbol,"
  },
  {
    "file": "1_58.jpg",
    "startSec": 118.24,
    "text": "en otro país."
  },
  {
    "file": "1_59.jpg",
    "startSec": 119.94,
    "text": "Número cuatro,"
  },
  {
    "file": "2_01.jpg",
    "startSec": 121.08,
    "text": "Texas,"
  },
  {
    "file": "2_02.jpg",
    "startSec": 121.8,
    "text": "2021,"
  },
  {
    "file": "2_03.jpg",
    "startSec": 123.22,
    "text": "el apagón helado."
  },
  {
    "file": "2_04.jpg",
    "startSec": 124.78,
    "text": "Una ola de frío con gel a las centrales,"
  },
  {
    "file": "2_07.jpg",
    "startSec": 127.42,
    "text": "cuatro millones y medio de casas y negocios se quedan sin luz y la red estuvo a cuatro minutos y 37 segundos de caer entera."
  },
  {
    "file": "2_15.jpg",
    "startSec": 135.16,
    "text": "El estado con todos 246 muertos,"
  },
  {
    "file": "2_18.jpg",
    "startSec": 138.08,
    "text": "al menos 19 por monóxido de carbono."
  },
  {
    "file": "2_20.jpg",
    "startSec": 140.98,
    "text": "¿Qué hacer?"
  },
  {
    "file": "2_22.jpg",
    "startSec": 142.04,
    "text": "Nunca enciendas un generador ni una barbacoa adentro de casa."
  },
  {
    "file": "2_25.jpg",
    "startSec": 145.86,
    "text": "Su estilo,"
  },
  {
    "file": "2_26.jpg",
    "startSec": 146.8,
    "text": "el estado del calor,"
  },
  {
    "file": "2_28.jpg",
    "startSec": 148.22,
    "text": "tumbado por el frío."
  },
  {
    "file": "2_30.jpg",
    "startSec": 150.44,
    "text": "Número cinco,"
  },
  {
    "file": "2_31.jpg",
    "startSec": 151.46,
    "text": "Besnes,"
  },
  {
    "file": "2_32.jpg",
    "startSec": 152.18,
    "text": "2019,"
  },
  {
    "file": "2_33.jpg",
    "startSec": 153.52,
    "text": "el apagón sin culpable."
  },
  {
    "file": "2_35.jpg",
    "startSec": 155.42,
    "text": "Faya Guri,"
  },
  {
    "file": "2_36.jpg",
    "startSec": 156.54,
    "text": "la presa que da cerca del 70 % de la electricidad del país."
  },
  {
    "file": "2_40.jpg",
    "startSec": 160.64,
    "text": "El gobierno habló de esa botaje."
  },
  {
    "file": "2_42.jpg",
    "startSec": 162.5,
    "text": "Los ingenieros hablaron de un incendio bajo la línea principal y de años sin mantenimiento."
  },
  {
    "file": "2_47.jpg",
    "startSec": 167.74,
    "text": "En Caracas separaron las bombas de agua y hubo gente llenando garrafas junto al río Guaire."
  },
  {
    "file": "2_53.jpg",
    "startSec": 173.38,
    "text": "¿Qué hacer?"
  },
  {
    "file": "2_54.jpg",
    "startSec": 174.46,
    "text": "Guarta agua embotellada en casa."
  },
  {
    "file": "2_56.jpg",
    "startSec": 176.62,
    "text": "Su estilo,"
  },
  {
    "file": "2_57.jpg",
    "startSec": 177.66,
    "text": "un país a oscuras y dos versiones de quién apagó la luz."
  },
  {
    "file": "3_01.jpg",
    "startSec": 181.94,
    "text": "Y ahora empiezan las causas raras,"
  },
  {
    "file": "3_04.jpg",
    "startSec": 184.32,
    "text": "número seis,"
  },
  {
    "file": "3_05.jpg",
    "startSec": 185.26,
    "text": "Chile,"
  },
  {
    "file": "3_06.jpg",
    "startSec": 185.82,
    "text": "2025,"
  },
  {
    "file": "3_07.jpg",
    "startSec": 187.24,
    "text": "el apagón de la reglo."
  },
  {
    "file": "3_08.jpg",
    "startSec": 188.96,
    "text": "Si apagan 14 de las 16 regiones del país,"
  },
  {
    "file": "3_12.jpg",
    "startSec": 192.18,
    "text": "esa noche hay toque de queda."
  },
  {
    "file": "3_14.jpg",
    "startSec": 194.04,
    "text": "La causa, según el coordinador eléctrico, una empresa tocó los equipos de una línea clave sin avisar y sin permiso."
  },
  {
    "file": "3_21.jpg",
    "startSec": 201.54,
    "text": "La protección saltó y la línea entera se cortó. ¿Qué hacer?"
  },
  {
    "file": "3_26.jpg",
    "startSec": 206.0,
    "text": "Lleva algo de efectivo,"
  },
  {
    "file": "3_27.jpg",
    "startSec": 207.44,
    "text": "si luz los datáfonos dejan de funcionar."
  },
  {
    "file": "3_30.jpg",
    "startSec": 210.38,
    "text": "Su estilo fue a regular una línea y apagó un país."
  },
  {
    "file": "3_35.jpg",
    "startSec": 215.28,
    "text": "Número siete,"
  },
  {
    "file": "3_36.jpg",
    "startSec": 216.52,
    "text": "Pakistan,"
  },
  {
    "file": "3_37.jpg",
    "startSec": 217.46,
    "text": "2023,"
  },
  {
    "file": "3_38.jpg",
    "startSec": 218.96,
    "text": "el apagón de la horro."
  },
  {
    "file": "3_41.jpg",
    "startSec": 221.34,
    "text": "Más de 220 millones de habitantes,"
  },
  {
    "file": "3_44.jpg",
    "startSec": 224.1,
    "text": "la mayoría sin luz."
  },
  {
    "file": "3_45.jpg",
    "startSec": 225.7,
    "text": "¿Por qué?"
  },
  {
    "file": "3_46.jpg",
    "startSec": 226.66,
    "text": "Para ahorrar combustible, apagaron parte de las centrales por la noche."
  },
  {
    "file": "3_50.jpg",
    "startSec": 230.44,
    "text": "Al encenderla subo un baiven de tensión y la red se fue desconectando entera."
  },
  {
    "file": "3_56.jpg",
    "startSec": 236.08,
    "text": "Su estilo apagaron la luz para ahorrar y luego nos supieron encenderla."
  },
  {
    "file": "4_01.jpg",
    "startSec": 241.06,
    "text": "Número ocho,"
  },
  {
    "file": "4_02.jpg",
    "startSec": 242.28,
    "text": "India,"
  },
  {
    "file": "4_03.jpg",
    "startSec": 242.96,
    "text": "2012,"
  },
  {
    "file": "4_04.jpg",
    "startSec": 244.28,
    "text": "el más grande de la historia."
  },
  {
    "file": "4_06.jpg",
    "startSec": 246.58,
    "text": "Cae la red del norte."
  },
  {
    "file": "4_08.jpg",
    "startSec": 248.12,
    "text": "Al día siguiente vuelve a caer y arrastra a la del este."
  },
  {
    "file": "4_11.jpg",
    "startSec": 251.88,
    "text": "Más de 600 millones de personas."
  },
  {
    "file": "4_14.jpg",
    "startSec": 254.48,
    "text": "Sientos de mineros se quedan atrapados bajo tierra."
  },
  {
    "file": "4_17.jpg",
    "startSec": 257.86,
    "text": "La causa?"
  },
  {
    "file": "4_19.jpg",
    "startSec": 259.04,
    "text": "Algunos estados tiraban de más electricidad de la que les tocaba y una línea clave saltó por ir demasiado cargada."
  },
  {
    "file": "4_25.jpg",
    "startSec": 265.66,
    "text": "Su estilo,"
  },
  {
    "file": "4_26.jpg",
    "startSec": 266.68,
    "text": "600 millones a oscuras y ni una avería."
  },
  {
    "file": "4_30.jpg",
    "startSec": 270.62,
    "text": "Y llegamos a los dos más raros."
  },
  {
    "file": "4_32.jpg",
    "startSec": 272.98,
    "text": "Ninguno empezó en la tierra."
  },
  {
    "file": "4_34.jpg",
    "startSec": 274.92,
    "text": "Número nueve, Quebec,"
  },
  {
    "file": "4_36.jpg",
    "startSec": 276.8,
    "text": "1989,"
  },
  {
    "file": "4_38.jpg",
    "startSec": 278.72,
    "text": "la tormenta solar."
  },
  {
    "file": "4_40.jpg",
    "startSec": 280.28,
    "text": "El sol lanza una nube de partículas y el campo magnético de la tierra se agita."
  },
  {
    "file": "4_45.jpg",
    "startSec": 285.14,
    "text": "Que ve que está sobre una roca que conduce muy mal."
  },
  {
    "file": "4_48.jpg",
    "startSec": 288.14,
    "text": "Así que esas corrientes se meten por las líneas."
  },
  {
    "file": "4_51.jpg",
    "startSec": 291.24,
    "text": "En menos de 90 segundos cae la red."
  },
  {
    "file": "4_53.jpg",
    "startSec": 293.88,
    "text": "6 millones de personas."
  },
  {
    "file": "4_55.jpg",
    "startSec": 295.82,
    "text": "Más de nueve horas."
  },
  {
    "file": "4_57.jpg",
    "startSec": 297.7,
    "text": "Su estilo lo apagó una estrella a 150 millones de kilómetros."
  },
  {
    "file": "5_03.jpg",
    "startSec": 303.1,
    "text": "Número diez,"
  },
  {
    "file": "5_04.jpg",
    "startSec": 304.22,
    "text": "Carrington,"
  },
  {
    "file": "5_05.jpg",
    "startSec": 305.16,
    "text": "1859,"
  },
  {
    "file": "5_06.jpg",
    "startSec": 306.98,
    "text": "y la pagó antes de la bombilla."
  },
  {
    "file": "5_09.jpg",
    "startSec": 309.24,
    "text": "Llega la tormenta solar más fuerte de la que hay registro. Se ven auroras hasta en Cuba."
  },
  {
    "file": "5_14.jpg",
    "startSec": 314.36,
    "text": "Los telegrafos hechas en chispas."
  },
  {
    "file": "5_16.jpg",
    "startSec": 316.6,
    "text": "Algunas estaciones se incendian."
  },
  {
    "file": "5_18.jpg",
    "startSec": 318.74,
    "text": "Pero aquí viene lo más raro."
  },
  {
    "file": "5_20.jpg",
    "startSec": 320.54,
    "text": "Entre Boston y Portland desconecta las baterías y siguen mandando mensajes con la corriente de la aurora."
  },
  {
    "file": "5_26.jpg",
    "startSec": 326.84,
    "text": "Y si pasara hoy."
  },
  {
    "file": "5_28.jpg",
    "startSec": 328.54,
    "text": "Lloyds calculó que sólo en Estados Unidos costaría hasta 2 ,6 billones de dólares."
  },
  {
    "file": "5_34.jpg",
    "startSec": 334.38,
    "text": "¿Qué hacer?"
  },
  {
    "file": "5_35.jpg",
    "startSec": 335.64,
    "text": "La Unión Europea recomienda un kit para 72 horas. Agua, comida, la interna y radioapilas."
  },
  {
    "file": "5_42.jpg",
    "startSec": 342.32,
    "text": "Su estilo todavía no había bombillas y aún así incendió los cables."
  },
  {
    "file": "5_47.jpg",
    "startSec": 347.96,
    "text": "Volvamos a la pregunta."
  },
  {
    "file": "5_49.jpg",
    "startSec": 349.62,
    "text": "¿Qué apagó España?"
  },
  {
    "file": "5_51.jpg",
    "startSec": 351.72,
    "text": "A las 12 y 33 desaparecieron 15 gigabatios en 5 segundos."
  },
  {
    "file": "5_56.jpg",
    "startSec": 356.34,
    "text": "El 60 % de lo que gastaba el país."
  },
  {
    "file": "5_59.jpg",
    "startSec": 359.48,
    "text": "En marzo de 2026, los expertos europeos publicaron su informe final."
  },
  {
    "file": "6_04.jpg",
    "startSec": 364.48,
    "text": "Su respuesta sobre tensión."
  },
  {
    "file": "6_07.jpg",
    "startSec": 367.26,
    "text": "La tensión de la red subió sin control."
  },
  {
    "file": "6_09.jpg",
    "startSec": 369.74,
    "text": "Las centrales se desconexaron para protegerse y cada desconexión la subía más."
  },
  {
    "file": "6_15.jpg",
    "startSec": 375.2,
    "text": "Pero ojo. El informe habla de varias causas a la vez y reparte el peso."
  },
  {
    "file": "6_19.jpg",
    "startSec": 379.78,
    "text": "Red eléctrica, las centrales y las normas."
  },
  {
    "file": "6_23.jpg",
    "startSec": 383.0,
    "text": "Y la culpa legal la decide otro."
  },
  {
    "file": "6_25.jpg",
    "startSec": 385.12,
    "text": "En abril de 2026,"
  },
  {
    "file": "6_27.jpg",
    "startSec": 387.02,
    "text": "la CNMC abrió expedientes a red eléctricas y a varias eléctricas."
  },
  {
    "file": "6_32.jpg",
    "startSec": 392.06,
    "text": "Su estilo sin rayo, sin árbol, sin vag. una atención que nadie supo frenar."
  },
  {
    "file": "6_38.jpg",
    "startSec": 398.28,
    "text": "¿Y tú?"
  },
  {
    "file": "6_39.jpg",
    "startSec": 399.34,
    "text": "¿Dónde te pidió el apagón?"
  },
  {
    "file": "6_40.jpg",
    "startSec": 400.96,
    "text": "Te leo en los comentarios."
  },
  {
    "file": "6_43.jpg",
    "startSec": 403.3,
    "text": "Si te gusta entender cómo funciona de verdad la tecnología que usas cada día, suscríbete."
  },
  {
    "file": "6_48.jpg",
    "startSec": 408.44,
    "text": "Cada semana una máquina, un invento o una idea explicada fácil."
  }
]