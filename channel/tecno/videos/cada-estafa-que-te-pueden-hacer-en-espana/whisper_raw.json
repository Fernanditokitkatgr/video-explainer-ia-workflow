[
  {
    "file": "0_00.jpg",
    "startSec": 0.0,
    "text": "Estás en Esofa,"
  },
  {
    "file": "0_01.jpg",
    "startSec": 1.28,
    "text": "te vibra el móvil."
  },
  {
    "file": "0_02.jpg",
    "startSec": 2.74,
    "text": "Es un SMS de tu banco,"
  },
  {
    "file": "0_04.jpg",
    "startSec": 4.74,
    "text": "en el mismo hilo que los de verdad."
  },
  {
    "file": "0_06.jpg",
    "startSec": 6.98,
    "text": "¿A alguien ha hecho un cargo enorme con tu tarjeta?"
  },
  {
    "file": "0_09.jpg",
    "startSec": 9.76,
    "text": "¿Y te dan un teléfono para pararlo?"
  },
  {
    "file": "0_11.jpg",
    "startSec": 11.94,
    "text": "¿Estu banco?"
  },
  {
    "file": "0_12.jpg",
    "startSec": 12.94,
    "text": "No."
  },
  {
    "file": "0_13.jpg",
    "startSec": 13.86,
    "text": "Y es solo la estafa más común."
  },
  {
    "file": "0_16.jpg",
    "startSec": 16.32,
    "text": "En 2024, la policía registró más de 412 .000 estafas por Internet en España."
  },
  {
    "file": "0_22.jpg",
    "startSec": 22.64,
    "text": "Aquí van diez, de la más común,"
  },
  {
    "file": "0_24.jpg",
    "startSec": 24.5,
    "text": "a la más rara."
  },
  {
    "file": "0_25.jpg",
    "startSec": 25.8,
    "text": "Y la última empezó en una web de fans de un actor de Hollywood,"
  },
  {
    "file": "0_29.jpg",
    "startSec": 29.08,
    "text": "¿A divinas de cual?"
  },
  {
    "file": "0_30.jpg",
    "startSec": 30.94,
    "text": "Número 1, el SMS del banco,"
  },
  {
    "file": "0_33.jpg",
    "startSec": 33.44,
    "text": "el febo."
  },
  {
    "file": "0_34.jpg",
    "startSec": 34.58,
    "text": "Ya viste de un cargo que nunca has hecho y te da un número para anularlo."
  },
  {
    "file": "0_38.jpg",
    "startSec": 38.5,
    "text": "Septiembre de 2021,"
  },
  {
    "file": "0_40.jpg",
    "startSec": 40.5,
    "text": "la Guardia Civil cierra la operación Ibermelo."
  },
  {
    "file": "0_43.jpg",
    "startSec": 43.24,
    "text": "Su centro podía mandar más de 100 .000 SMS falsos a la hora."
  },
  {
    "file": "0_48.jpg",
    "startSec": 48.2,
    "text": "29 detenidos y más de un millón de euros robados."
  },
  {
    "file": "0_52.jpg",
    "startSec": 52.02,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "0_53.jpg",
    "startSec": 53.42,
    "text": "Nunca llames al número del mensaje."
  },
  {
    "file": "0_55.jpg",
    "startSec": 55.56,
    "text": "Abretula, app de tu banco."
  },
  {
    "file": "0_57.jpg",
    "startSec": 57.54,
    "text": "Su estilo te asusta con un cargo y el cargo llega cuando le llamas."
  },
  {
    "file": "1_02.jpg",
    "startSec": 62.74,
    "text": "Número 2, la multa falsa,"
  },
  {
    "file": "1_04.jpg",
    "startSec": 64.92,
    "text": "el cobrador."
  },
  {
    "file": "1_06.jpg",
    "startSec": 66.1,
    "text": "Te escribe la DGT o correos,"
  },
  {
    "file": "1_08.jpg",
    "startSec": 68.74,
    "text": "tienes algo pendiente por unos céntimos."
  },
  {
    "file": "1_11.jpg",
    "startSec": 71.26,
    "text": "Incibe avisó de uno de correos,"
  },
  {
    "file": "1_13.jpg",
    "startSec": 73.34,
    "text": "pedía 80 céntimos por volver a enviarte un paquete."
  },
  {
    "file": "1_16.jpg",
    "startSec": 76.62,
    "text": "¿Para qué quieren 80 céntimos?"
  },
  {
    "file": "1_18.jpg",
    "startSec": 78.88,
    "text": "No los quieren,"
  },
  {
    "file": "1_19.jpg",
    "startSec": 79.76,
    "text": "quieren tu tarjeta."
  },
  {
    "file": "1_21.jpg",
    "startSec": 81.34,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "1_22.jpg",
    "startSec": 82.5,
    "text": "La DGT solo avisa por carta o por subuzón oficial,"
  },
  {
    "file": "1_25.jpg",
    "startSec": 85.92,
    "text": "ninguna multa suya lleva enlaces."
  },
  {
    "file": "1_28.jpg",
    "startSec": 88.46,
    "text": "Su estilo te pide 80 céntimos y se queda con todo lo demás."
  },
  {
    "file": "1_33.jpg",
    "startSec": 93.66,
    "text": "Número 3,"
  },
  {
    "file": "1_34.jpg",
    "startSec": 94.48,
    "text": "el hola mamá,"
  },
  {
    "file": "1_35.jpg",
    "startSec": 95.56,
    "text": "el hijo falso."
  },
  {
    "file": "1_37.jpg",
    "startSec": 97.26,
    "text": "Hola mamá, se me ha roto el móvil,"
  },
  {
    "file": "1_38.jpg",
    "startSec": 98.94,
    "text": "este es mi número nuevo."
  },
  {
    "file": "1_40.jpg",
    "startSec": 100.66,
    "text": "Al rato te pide dinero,"
  },
  {
    "file": "1_42.jpg",
    "startSec": 102.22,
    "text": "es urgente."
  },
  {
    "file": "1_43.jpg",
    "startSec": 103.7,
    "text": "En febrero de 2024,"
  },
  {
    "file": "1_45.jpg",
    "startSec": 105.58,
    "text": "la policía nacional de tubo a 65 personas por este timo. En un portátil guardaban más de 500 hojas de cálculo,"
  },
  {
    "file": "1_52.jpg",
    "startSec": 112.8,
    "text": "llenas de datos de posibles víctimas."
  },
  {
    "file": "1_55.jpg",
    "startSec": 115.14,
    "text": "Con inteligencia artificial ya imitan hasta la voz."
  },
  {
    "file": "1_58.jpg",
    "startSec": 118.68,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "1_59.jpg",
    "startSec": 119.86,
    "text": "Llama a tu hijo a su número de siempre."
  },
  {
    "file": "2_02.jpg",
    "startSec": 122.26,
    "text": "Su estilo,"
  },
  {
    "file": "2_03.jpg",
    "startSec": 123.38,
    "text": "tu hijo de siempre,"
  },
  {
    "file": "2_04.jpg",
    "startSec": 124.62,
    "text": "con un número que nunca has visto."
  },
  {
    "file": "2_07.jpg",
    "startSec": 127.16,
    "text": "Número 4, el vízum inverso, el comprador al revés."
  },
  {
    "file": "2_11.jpg",
    "startSec": 131.3,
    "text": "Vendes algo en internet,"
  },
  {
    "file": "2_12.jpg",
    "startSec": 132.7,
    "text": "alguien te lo quiere pagar por vízum,"
  },
  {
    "file": "2_14.jpg",
    "startSec": 134.74,
    "text": "pero aquí viene lo raro. Dice que el pago lo tienes que aceptar tu."
  },
  {
    "file": "2_18.jpg",
    "startSec": 138.86,
    "text": "Aceptas y el dinero sale de tu cuenta."
  },
  {
    "file": "2_21.jpg",
    "startSec": 141.72,
    "text": "En 2025, la policía nacional desarticuló una red así en Cádiz,"
  },
  {
    "file": "2_26.jpg",
    "startSec": 146.68,
    "text": "207 víctimas."
  },
  {
    "file": "2_29.jpg",
    "startSec": 149.02,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "2_30.jpg",
    "startSec": 150.38,
    "text": "Para cobrar un vízum nunca tienes que aceptar nada,"
  },
  {
    "file": "2_33.jpg",
    "startSec": 153.22,
    "text": "si aceptas estás pagando."
  },
  {
    "file": "2_35.jpg",
    "startSec": 155.62,
    "text": "Su estilo dice que te paga y le paga a su."
  },
  {
    "file": "2_39.jpg",
    "startSec": 159.26,
    "text": "Número 5,"
  },
  {
    "file": "2_40.jpg",
    "startSec": 160.5,
    "text": "la llamada del banco,"
  },
  {
    "file": "2_41.jpg",
    "startSec": 161.78,
    "text": "el doble."
  },
  {
    "file": "2_42.jpg",
    "startSec": 162.78,
    "text": "Te llama tu banco,"
  },
  {
    "file": "2_44.jpg",
    "startSec": 164.04,
    "text": "en la pantalla sale su número de verdad,"
  },
  {
    "file": "2_46.jpg",
    "startSec": 166.4,
    "text": "pero ese spufing falsifica en el número que ves."
  },
  {
    "file": "2_49.jpg",
    "startSec": 169.84,
    "text": "En 2022, la policía nacional detuvo a 8 personas que lo hacían, casi 3 millones de euros."
  },
  {
    "file": "2_56.jpg",
    "startSec": 176.22,
    "text": "Te pedía a los códigos del móvil para anular la operación,"
  },
  {
    "file": "2_59.jpg",
    "startSec": 179.38,
    "text": "pero cada código no la anulaba,"
  },
  {
    "file": "3_01.jpg",
    "startSec": 181.62,
    "text": "la aprobaba."
  },
  {
    "file": "3_03.jpg",
    "startSec": 183.02,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "3_04.jpg",
    "startSec": 184.24,
    "text": "Cuelga y llama tu al número de tu tarjeta."
  },
  {
    "file": "3_07.jpg",
    "startSec": 187.6,
    "text": "Su estilo tiene la voz de tu banco y la cartera de otro."
  },
  {
    "file": "3_11.jpg",
    "startSec": 191.78,
    "text": "Número 6,"
  },
  {
    "file": "3_12.jpg",
    "startSec": 192.98,
    "text": "el falso técnico, el que nadie ha llamado."
  },
  {
    "file": "3_15.jpg",
    "startSec": 195.98,
    "text": "Te llaman de Microsoft,"
  },
  {
    "file": "3_17.jpg",
    "startSec": 197.3,
    "text": "tu ordenador tiene un virus,"
  },
  {
    "file": "3_18.jpg",
    "startSec": 198.8,
    "text": "en octubre de 2026 se juzgó en vivo a una red así."
  },
  {
    "file": "3_22.jpg",
    "startSec": 202.72,
    "text": "El que llamaba se hacía llamar Harrison guiaba a sus víctimas durante horas,"
  },
  {
    "file": "3_27.jpg",
    "startSec": 207.72,
    "text": "al final les habían vaciado las cuentas."
  },
  {
    "file": "3_30.jpg",
    "startSec": 210.54,
    "text": "Cerca de 60 mil euros."
  },
  {
    "file": "3_32.jpg",
    "startSec": 212.64,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "3_34.jpg",
    "startSec": 214.1,
    "text": "Microsoft nunca te llama para arreglarte el ordenador."
  },
  {
    "file": "3_37.jpg",
    "startSec": 217.12,
    "text": "Su estilo viene a quitarte un virus, y el virus es él."
  },
  {
    "file": "3_42.jpg",
    "startSec": 222.2,
    "text": "Y ahora empiezan las raras."
  },
  {
    "file": "3_44.jpg",
    "startSec": 224.18,
    "text": "Número 7,"
  },
  {
    "file": "3_45.jpg",
    "startSec": 225.1,
    "text": "el alquiler fantasma,"
  },
  {
    "file": "3_46.jpg",
    "startSec": 226.52,
    "text": "la casera de mentira."
  },
  {
    "file": "3_48.jpg",
    "startSec": 228.34,
    "text": "Encuentras un piso en idealista, lo visitas, firmas y te da las llaves."
  },
  {
    "file": "3_53.jpg",
    "startSec": 233.22,
    "text": "Febrero de 2026,"
  },
  {
    "file": "3_55.jpg",
    "startSec": 235.36,
    "text": "la Policía Nacional detiene en Madrid a una mujer de 40 años."
  },
  {
    "file": "3_59.jpg",
    "startSec": 239.32,
    "text": "Reservaba pisos en Airbnb y los anunciaba como alquiler de larga duración. Firmaba con varios inquilinos a la vez y el día de la mudanza llegaron todos al mismo piso."
  },
  {
    "file": "4_09.jpg",
    "startSec": 249.78,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "4_11.jpg",
    "startSec": 251.34,
    "text": "Ver el piso no basta,"
  },
  {
    "file": "4_12.jpg",
    "startSec": 252.78,
    "text": "pide la nota simple del registro,"
  },
  {
    "file": "4_14.jpg",
    "startSec": 254.62,
    "text": "ahí sale el dueña de verdad."
  },
  {
    "file": "4_16.jpg",
    "startSec": 256.68,
    "text": "Su estilo,"
  },
  {
    "file": "4_17.jpg",
    "startSec": 257.76,
    "text": "te enseña el piso,"
  },
  {
    "file": "4_18.jpg",
    "startSec": 258.92,
    "text": "pero el piso nunca fue suyo."
  },
  {
    "file": "4_21.jpg",
    "startSec": 261.18,
    "text": "Número 8,"
  },
  {
    "file": "4_22.jpg",
    "startSec": 262.28,
    "text": "el famoso falso,"
  },
  {
    "file": "4_23.jpg",
    "startSec": 263.72,
    "text": "el anuncio de mentira."
  },
  {
    "file": "4_25.jpg",
    "startSec": 265.54,
    "text": "Un famoso te recomienda invertir en criptomonedas,"
  },
  {
    "file": "4_28.jpg",
    "startSec": 268.4,
    "text": "su cara,"
  },
  {
    "file": "4_29.jpg",
    "startSec": 269.12,
    "text": "su voz,"
  },
  {
    "file": "4_30.jpg",
    "startSec": 270.02,
    "text": "hechas con inteligencia artificial. Abril de 2025,"
  },
  {
    "file": "4_34.jpg",
    "startSec": 274.54,
    "text": "cae una red en alicante,"
  },
  {
    "file": "4_36.jpg",
    "startSec": 276.14,
    "text": "19 millones de euros,"
  },
  {
    "file": "4_38.jpg",
    "startSec": 278.14,
    "text": "208 víctimas."
  },
  {
    "file": "4_40.jpg",
    "startSec": 280.28,
    "text": "Y cuando lo perdías todo volvían a escribirte,"
  },
  {
    "file": "4_43.jpg",
    "startSec": 283.06,
    "text": "como falsos agentes de Europol para cobrarte los impuestos de recuperarlo."
  },
  {
    "file": "4_47.jpg",
    "startSec": 287.82,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "4_49.jpg",
    "startSec": 289.18,
    "text": "Si te promete en ganarse en riesgo, es una estafa."
  },
  {
    "file": "4_52.jpg",
    "startSec": 292.6,
    "text": "Su estilo,"
  },
  {
    "file": "4_53.jpg",
    "startSec": 293.62,
    "text": "te estafa dos veces y la segunda vestido de policía."
  },
  {
    "file": "4_57.jpg",
    "startSec": 297.58,
    "text": "Número 9,"
  },
  {
    "file": "4_58.jpg",
    "startSec": 298.8,
    "text": "el SIM Swapping,"
  },
  {
    "file": "5_00.jpg",
    "startSec": 300.2,
    "text": "el ladrón de tu número."
  },
  {
    "file": "5_01.jpg",
    "startSec": 301.74,
    "text": "Un día tu móvil se queda sin cobertura,"
  },
  {
    "file": "5_04.jpg",
    "startSec": 304.34,
    "text": "tu número ya está en otra tarjeta y los códigos del banco le llegan a otro."
  },
  {
    "file": "5_09.jpg",
    "startSec": 309.18,
    "text": "Diciembre de 2024,"
  },
  {
    "file": "5_11.jpg",
    "startSec": 311.3,
    "text": "cae una red de los trimitarios en Barcelona y Tarragona,"
  },
  {
    "file": "5_14.jpg",
    "startSec": 314.6,
    "text": "20 detenidos,"
  },
  {
    "file": "5_15.jpg",
    "startSec": 315.76,
    "text": "429 mil euros y al menos 100 identidades robadas."
  },
  {
    "file": "5_20.jpg",
    "startSec": 320.62,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "5_22.jpg",
    "startSec": 322.06,
    "text": "Si te queda sin cobertura sin motivo,"
  },
  {
    "file": "5_23.jpg",
    "startSec": 323.96,
    "text": "llama a tu operadora."
  },
  {
    "file": "5_25.jpg",
    "startSec": 325.5,
    "text": "Su estilo,"
  },
  {
    "file": "5_26.jpg",
    "startSec": 326.5,
    "text": "nunca te roba el móvil,"
  },
  {
    "file": "5_28.jpg",
    "startSec": 328.02,
    "text": "te roba el número."
  },
  {
    "file": "5_29.jpg",
    "startSec": 329.42,
    "text": "Y llegamos a la última,"
  },
  {
    "file": "5_31.jpg",
    "startSec": 331.06,
    "text": "la más rara de todas."
  },
  {
    "file": "5_32.jpg",
    "startSec": 332.88,
    "text": "Número 10,"
  },
  {
    "file": "5_34.jpg",
    "startSec": 334.02,
    "text": "la estafa del amor,"
  },
  {
    "file": "5_35.jpg",
    "startSec": 335.42,
    "text": "el novio de película."
  },
  {
    "file": "5_37.jpg",
    "startSec": 337.4,
    "text": "Conoces a alguien por internet,"
  },
  {
    "file": "5_39.jpg",
    "startSec": 339.24,
    "text": "te promete un futuro juntos y un día necesita dinero."
  },
  {
    "file": "5_43.jpg",
    "startSec": 343.08,
    "text": "Agosto de 2023,"
  },
  {
    "file": "5_45.jpg",
    "startSec": 345.08,
    "text": "una mujer de granada denuncia que le han quitado 175 mil euros."
  },
  {
    "file": "5_49.jpg",
    "startSec": 349.48,
    "text": "La guardia civil encuentra otra víctima en bizcaya."
  },
  {
    "file": "5_52.jpg",
    "startSec": 352.48,
    "text": "Las dos venían de la misma web de fans. En un registro apareció una agenda,"
  },
  {
    "file": "5_57.jpg",
    "startSec": 357.46,
    "text": "con las frases que usaban para engañarlas."
  },
  {
    "file": "6_00.jpg",
    "startSec": 360.34,
    "text": "Volvamos a la pregunta,"
  },
  {
    "file": "6_01.jpg",
    "startSec": 361.98,
    "text": "¿de qué actor era la web?"
  },
  {
    "file": "6_04.jpg",
    "startSec": 364.06,
    "text": "Brad Pitt,"
  },
  {
    "file": "6_05.jpg",
    "startSec": 365.18,
    "text": "las dos creían salir con Brad Pitt y él les propuso invertir juntos."
  },
  {
    "file": "6_10.jpg",
    "startSec": 370.84,
    "text": "325 mil euros entre las dos."
  },
  {
    "file": "6_13.jpg",
    "startSec": 373.64,
    "text": "¿Cómo pillarla?"
  },
  {
    "file": "6_15.jpg",
    "startSec": 375.0,
    "text": "Si alguien a quien nunca has visto te pide dinero, es una estafa."
  },
  {
    "file": "6_19.jpg",
    "startSec": 379.08,
    "text": "Su estilo,"
  },
  {
    "file": "6_20.jpg",
    "startSec": 380.12,
    "text": "la única estafa que te rompe el corazón y la cuenta."
  },
  {
    "file": "6_24.jpg",
    "startSec": 384.3,
    "text": "¿Y tú?"
  },
  {
    "file": "6_25.jpg",
    "startSec": 385.5,
    "text": "¿Cuál de las diez te ha llegado ya?"
  },
  {
    "file": "6_27.jpg",
    "startSec": 387.46,
    "text": "Te leo en los comentarios."
  },
  {
    "file": "6_29.jpg",
    "startSec": 389.7,
    "text": "Si te gusta entender cómo funciona de verdad la tecnología que usas cada día, suscríbete."
  },
  {
    "file": "6_34.jpg",
    "startSec": 394.68,
    "text": "Cada semana, una máquina, un invento o una idea explicada fácil."
  }
]