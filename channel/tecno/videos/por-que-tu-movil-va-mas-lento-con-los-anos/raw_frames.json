[
  {
    "file": "v3_0_00.jpg",
    "startSec": 0.0,
    "text": "Desbloqueas el móvil. Y tarda."
  },
  {
    "file": "v3_0_02.jpg",
    "startSec": 2.96,
    "text": "Hace dos años volaba"
  },
  {
    "file": "v3_0_04.jpg",
    "startSec": 4.08,
    "text": "y no ya has hecho nada."
  },
  {
    "file": "v3_0_05.jpg",
    "startSec": 5.96,
    "text": "¿Se ha estropeado? No."
  },
  {
    "file": "v3_0_07.jpg",
    "startSec": 7.66,
    "text": "Hay una explicación."
  },
  {
    "file": "v3_0_08.jpg",
    "startSec": 8.92,
    "text": "Bueno, hay diez."
  },
  {
    "file": "v3_0_10.jpg",
    "startSec": 10.36,
    "text": "Y al final la gran pregunta."
  },
  {
    "file": "v3_0_12.jpg",
    "startSec": 12.42,
    "text": "¿Te lo hacen a propósito?"
  },
  {
    "file": "v3_0_13.jpg",
    "startSec": 13.78,
    "text": "Estas son las diez razones por las que tu móvil"
  },
  {
    "file": "v3_0_16.jpg",
    "startSec": 16.0,
    "text": "va más lento con los años."
  },
  {
    "file": "v3_0_17.jpg",
    "startSec": 17.86,
    "text": "Te las cuento de una en una,"
  },
  {
    "file": "v3_0_19.jpg",
    "startSec": 19.28,
    "text": "de la más común a la más sorprendente."
  },
  {
    "file": "v3_0_21.jpg",
    "startSec": 21.62,
    "text": "Número uno."
  },
  {
    "file": "v3_0_23.jpg",
    "startSec": 22.6,
    "text": "La memoria llena. El trastero."
  },
  {
    "file": "v3_0_24.jpg",
    "startSec": 24.74,
    "text": "La memoria de tu móvil no escribe encima de lo viejo."
  },
  {
    "file": "v3_0_27.jpg",
    "startSec": 27.36,
    "text": "Primero tiene que borrar."
  },
  {
    "file": "v3_0_28.jpg",
    "startSec": 28.48,
    "text": "Si está casi llena,"
  },
  {
    "file": "v3_0_30.jpg",
    "startSec": 30.0,
    "text": "cada foto nueva es un Tetris."
  },
  {
    "file": "v3_0_31.jpg",
    "startSec": 31.88,
    "text": "Y todo se atasca."
  },
  {
    "file": "v3_0_33.jpg",
    "startSec": 33.16,
    "text": "En 2013, la tablet Nexus 7"
  },
  {
    "file": "v3_0_34.jpg",
    "startSec": 34.94,
    "text": "de Google se arrastraba por algo así."
  },
  {
    "file": "v3_0_37.jpg",
    "startSec": 37.06,
    "text": "Lo arregló una actualización."
  },
  {
    "file": "v3_0_38.jpg",
    "startSec": 38.58,
    "text": "Así que entra en ajustes, almacenamiento,"
  },
  {
    "file": "v3_0_41.jpg",
    "startSec": 41.06,
    "text": "y borra las apps que no usas."
  },
  {
    "file": "v3_0_42.jpg",
    "startSec": 42.78,
    "text": "Deja libre un buen trozo."
  },
  {
    "file": "v3_0_44.jpg",
    "startSec": 44.22,
    "text": "Número dos."
  },
  {
    "file": "v3_0_45.jpg",
    "startSec": 45.14,
    "text": "Las apps que engordan. La mochila."
  },
  {
    "file": "v3_0_47.jpg",
    "startSec": 47.48,
    "text": "Cada año tus apps hacen"
  },
  {
    "file": "v3_0_48.jpg",
    "startSec": 48.74,
    "text": "más cosas. Y pesan más."
  },
  {
    "file": "v3_0_50.jpg",
    "startSec": 50.84,
    "text": "Sensor Tower midió las diez apps"
  },
  {
    "file": "v3_0_52.jpg",
    "startSec": 52.46,
    "text": "más instaladas en iPhone en Estados Unidos."
  },
  {
    "file": "v3_0_54.jpg",
    "startSec": 54.52,
    "text": "En 2013 ocupaban"
  },
  {
    "file": "v3_0_56.jpg",
    "startSec": 56.08,
    "text": "164 Megas."
  },
  {
    "file": "v3_0_57.jpg",
    "startSec": 57.8,
    "text": "En 2017 casi dos gigas,"
  },
  {
    "file": "v3_1_00.jpg",
    "startSec": 60.38,
    "text": "11 veces más."
  },
  {
    "file": "v3_1_01.jpg",
    "startSec": 61.64,
    "text": "Lo que usas poco, abrelo en la web."
  },
  {
    "file": "v3_1_03.jpg",
    "startSec": 63.8,
    "text": "La app se llama igual,"
  },
  {
    "file": "v3_1_04.jpg",
    "startSec": 64.98,
    "text": "pero cada año pesa más."
  },
  {
    "file": "v3_1_06.jpg",
    "startSec": 66.82,
    "text": "Número tres. Las apps en segundo plano."
  },
  {
    "file": "v3_1_09.jpg",
    "startSec": 69.24,
    "text": "Él ocupa. Cierras una app."
  },
  {
    "file": "v3_1_11.jpg",
    "startSec": 71.2,
    "text": "Pero muchas siguen despiertas por detrás."
  },
  {
    "file": "v3_1_13.jpg",
    "startSec": 73.72,
    "text": "En 2015, Facebook admitió que su app de iPhone"
  },
  {
    "file": "v3_1_16.jpg",
    "startSec": 76.2,
    "text": "dejaba el audio abierto después de ver un video."
  },
  {
    "file": "v3_1_18.jpg",
    "startSec": 78.82,
    "text": "Así seguía viva,"
  },
  {
    "file": "v3_1_20.jpg",
    "startSec": 80.1,
    "text": "comiéndose batería y procesador."
  },
  {
    "file": "v3_1_21.jpg",
    "startSec": 81.86,
    "text": "Quitales el permiso de segundo"
  },
  {
    "file": "v3_1_23.jpg",
    "startSec": 83.28,
    "text": "plano a las que no lo necesitan."
  },
  {
    "file": "v3_1_25.jpg",
    "startSec": 85.08,
    "text": "Les cierras la puerta y se quedan dentro."
  },
  {
    "file": "v3_1_27.jpg",
    "startSec": 87.6,
    "text": "Número cuatro. La batería. El abuelo."
  },
  {
    "file": "v3_1_30.jpg",
    "startSec": 90.3,
    "text": "Las baterías del hitio envejecen con cada carga."
  },
  {
    "file": "v3_1_32.jpg",
    "startSec": 92.94,
    "text": "Según Apple, hasta el iPhone 14 conservan"
  },
  {
    "file": "v3_1_35.jpg",
    "startSec": 95.1,
    "text": "el 80 % después de 500 ciclos."
  },
  {
    "file": "v3_1_37.jpg",
    "startSec": 97.62,
    "text": "En el 15, después de 1000"
  },
  {
    "file": "v3_1_40.jpg",
    "startSec": 99.08,
    "text": "y una batería vieja dan menos fuerza de golpe."
  },
  {
    "file": "v3_1_42.jpg",
    "startSec": 102.14,
    "text": "Tanto que el móvil puede apagarse solo."
  },
  {
    "file": "v3_1_44.jpg",
    "startSec": 104.46,
    "text": "Mira su estado en ajustes, batería."
  },
  {
    "file": "v3_1_46.jpg",
    "startSec": 106.62,
    "text": "Si baja del 80 % cambia la."
  },
  {
    "file": "v3_1_48.jpg",
    "startSec": 108.9,
    "text": "Cada carga le suma"
  },
  {
    "file": "v3_1_49.jpg",
    "startSec": 109.9,
    "text": "una ruga."
  },
  {
    "file": "v3_1_51.jpg",
    "startSec": 110.82,
    "text": "Número cinco. El calor. El dormilón."
  },
  {
    "file": "v3_1_53.jpg",
    "startSec": 113.7,
    "text": "Si el chip se calienta además,"
  },
  {
    "file": "v3_1_55.jpg",
    "startSec": 115.22,
    "text": "el móvil se frena solo para protegerse."
  },
  {
    "file": "v3_1_57.jpg",
    "startSec": 117.58,
    "text": "Apple dice que el iPhone está hecho para usarse"
  },
  {
    "file": "v3_1_59.jpg",
    "startSec": 119.5,
    "text": "entre 0 y 35 grados."
  },
  {
    "file": "v3_2_01.jpg",
    "startSec": 121.42,
    "text": "En 2023,"
  },
  {
    "file": "v3_2_02.jpg",
    "startSec": 122.76,
    "text": "el iPhone 15 Pro salió quemando."
  },
  {
    "file": "v3_2_04.jpg",
    "startSec": 124.96,
    "text": "Apple culpó a un fallo suyo"
  },
  {
    "file": "v3_2_06.jpg",
    "startSec": 126.44,
    "text": "y apps como Instagram y Uber."
  },
  {
    "file": "v3_2_08.jpg",
    "startSec": 128.72,
    "text": "No juegas mientras carga"
  },
  {
    "file": "v3_2_09.jpg",
    "startSec": 129.98,
    "text": "y no lo dejes al sol."
  },
  {
    "file": "v3_2_11.jpg",
    "startSec": 131.82,
    "text": "Cuando suda se echa la siesta."
  },
  {
    "file": "v3_2_13.jpg",
    "startSec": 133.98,
    "text": "Número seis. Las actualizaciones."
  },
  {
    "file": "v3_2_16.jpg",
    "startSec": 136.28,
    "text": "El traje de otra talla."
  },
  {
    "file": "v3_2_17.jpg",
    "startSec": 137.86,
    "text": "Cada sistema nuevo se diseña"
  },
  {
    "file": "v3_2_19.jpg",
    "startSec": 139.14,
    "text": "para chips más potentes."
  },
  {
    "file": "v3_2_20.jpg",
    "startSec": 140.44,
    "text": "Y al tuyo le queda pequeño."
  },
  {
    "file": "v3_2_22.jpg",
    "startSec": 142.56,
    "text": "En 2018,"
  },
  {
    "file": "v3_2_23.jpg",
    "startSec": 143.82,
    "text": "Italia multó a Apple con 10 millones"
  },
  {
    "file": "v3_2_25.jpg",
    "startSec": 145.5,
    "text": "de euros y Samsung con 5."
  },
  {
    "file": "v3_2_27.jpg",
    "startSec": 147.96,
    "text": "Por insistir en actualizar el iPhone 6 y el Galaxy"
  },
  {
    "file": "v3_2_30.jpg",
    "startSec": 150.28,
    "text": "Note 4 sin avisar de que irían peor."
  },
  {
    "file": "v3_2_32.jpg",
    "startSec": 152.94,
    "text": "Antes de una actualización grande, espera unos días."
  },
  {
    "file": "v3_2_35.jpg",
    "startSec": 155.84,
    "text": "Las de seguridad instala la siempre."
  },
  {
    "file": "v3_2_38.jpg",
    "startSec": 158.12,
    "text": "Y ahora vienen las sorprendentes."
  },
  {
    "file": "v3_2_40.jpg",
    "startSec": 160.24,
    "text": "Número siete. La asensación."
  },
  {
    "file": "v3_2_42.jpg",
    "startSec": 162.52,
    "text": "El escaparate."
  },
  {
    "file": "v3_2_43.jpg",
    "startSec": 163.78,
    "text": "En 2014, una investigadora"
  },
  {
    "file": "v3_2_45.jpg",
    "startSec": 165.7,
    "text": "de Harvard miró las búsqueras de Google."
  },
  {
    "file": "v3_2_47.jpg",
    "startSec": 167.44,
    "text": "Las de iPhone lento se disparaban"
  },
  {
    "file": "v3_2_49.jpg",
    "startSec": 169.46,
    "text": "justo cuando salía un iPhone nuevo."
  },
  {
    "file": "v3_2_51.jpg",
    "startSec": 171.44,
    "text": "Las de Samsung al excelento. No."
  },
  {
    "file": "v3_2_53.jpg",
    "startSec": 173.74,
    "text": "Coincidir no demuestra trampa."
  },
  {
    "file": "v3_2_55.jpg",
    "startSec": 175.7,
    "text": "Puede ser el sistema nuevo que sale a la vez."
  },
  {
    "file": "v3_2_58.jpg",
    "startSec": 178.14,
    "text": "Lo que ayuda es reducir las animaciones."
  },
  {
    "file": "v3_3_00.jpg",
    "startSec": 180.38,
    "text": "En iPhone, en accesibilidad, movimiento."
  },
  {
    "file": "v3_3_02.jpg",
    "startSec": 182.96,
    "text": "En Android, en opciones de desarrollador."
  },
  {
    "file": "v3_3_05.jpg",
    "startSec": 185.12,
    "text": "Tu móvil sigue igual."
  },
  {
    "file": "v3_3_06.jpg",
    "startSec": 186.44,
    "text": "El que ha cambiado es el del escaparate."
  },
  {
    "file": "v3_3_08.jpg",
    "startSec": 188.42,
    "text": "Pero esa sospecha tenía algo de verdad."
  },
  {
    "file": "v3_3_10.jpg",
    "startSec": 190.86,
    "text": "Número ocho. El battery gate."
  },
  {
    "file": "v3_3_13.jpg",
    "startSec": 193.04,
    "text": "El freno secreto."
  },
  {
    "file": "v3_3_14.jpg",
    "startSec": 194.64,
    "text": "2017. Un usuario cambia la batería"
  },
  {
    "file": "v3_3_16.jpg",
    "startSec": 196.98,
    "text": "de su iPhone 6S y de repente vuela."
  },
  {
    "file": "v3_3_19.jpg",
    "startSec": 199.72,
    "text": "El creador de Geekbench mira sus datos."
  },
  {
    "file": "v3_3_21.jpg",
    "startSec": 201.96,
    "text": "Después de una actualización,"
  },
  {
    "file": "v3_3_23.jpg",
    "startSec": 203.48,
    "text": "los iPhone con batería gastada"
  },
  {
    "file": "v3_3_24.jpg",
    "startSec": 204.78,
    "text": "iban más lentos."
  },
  {
    "file": "v3_3_26.jpg",
    "startSec": 206.32,
    "text": "Apple lo confirmó."
  },
  {
    "file": "v3_3_27.jpg",
    "startSec": 207.62,
    "text": "Los frenaba para que no se apagaran solos."
  },
  {
    "file": "v3_3_29.jpg",
    "startSec": 209.86,
    "text": "Y no lo había contado."
  },
  {
    "file": "v3_3_31.jpg",
    "startSec": 211.36,
    "text": "En Estados Unidos aceptó pagar"
  },
  {
    "file": "v3_3_32.jpg",
    "startSec": 212.72,
    "text": "hasta 500 millones de dólares."
  },
  {
    "file": "v3_3_34.jpg",
    "startSec": 214.76,
    "text": "En Francia, 25 millones de euros de multa."
  },
  {
    "file": "v3_3_37.jpg",
    "startSec": 217.32,
    "text": "Y en España, la OCEU lo llevó a los tribunales."
  },
  {
    "file": "v3_3_40.jpg",
    "startSec": 220.1,
    "text": "Hoy puedes desactivar ese freno en ajustes."
  },
  {
    "file": "v3_3_42.jpg",
    "startSec": 222.26,
    "text": "batería, estado."
  },
  {
    "file": "v3_3_43.jpg",
    "startSec": 223.94,
    "text": "O cambiar la batería."
  },
  {
    "file": "v3_3_45.jpg",
    "startSec": 225.32,
    "text": "Te frenaba por tu bien."
  },
  {
    "file": "v3_3_46.jpg",
    "startSec": 226.88,
    "text": "Pero se le olvidó decirte lo."
  },
  {
    "file": "v3_3_48.jpg",
    "startSec": 228.64,
    "text": "Número 9. El fin de las actualizaciones."
  },
  {
    "file": "v3_3_51.jpg",
    "startSec": 231.48,
    "text": "La fecha de caducidad."
  },
  {
    "file": "v3_3_52.jpg",
    "startSec": 232.84,
    "text": "Un día, dejan de llegar."
  },
  {
    "file": "v3_3_54.jpg",
    "startSec": 234.52,
    "text": "Y las apps piden un sistema que ya no tienes."
  },
  {
    "file": "v3_3_57.jpg",
    "startSec": 237.02,
    "text": "En 2015, Francia hizo delito la obsolescencia"
  },
  {
    "file": "v3_3_59.jpg",
    "startSec": 239.52,
    "text": "programada con hasta dos años de cárcel."
  },
  {
    "file": "v3_4_02.jpg",
    "startSec": 242.26,
    "text": "Desde junio de 2025,"
  },
  {
    "file": "v3_4_04.jpg",
    "startSec": 244.04,
    "text": "la Unión Europea exige al menos"
  },
  {
    "file": "v3_4_05.jpg",
    "startSec": 245.4,
    "text": "cinco años de actualizaciones."
  },
  {
    "file": "v3_4_07.jpg",
    "startSec": 247.14,
    "text": "Y en 2027 llega la norma de baterías"
  },
  {
    "file": "v3_4_09.jpg",
    "startSec": 249.56,
    "text": "cambiables con excepciones"
  },
  {
    "file": "v3_4_11.jpg",
    "startSec": 251.12,
    "text": "para las más duraderas."
  },
  {
    "file": "v3_4_12.jpg",
    "startSec": 252.62,
    "text": "Antes de comprar, mira cuántos años"
  },
  {
    "file": "v3_4_14.jpg",
    "startSec": 254.4,
    "text": "de actualizaciones promete la marca."
  },
  {
    "file": "v3_4_16.jpg",
    "startSec": 256.4,
    "text": "Y la última. La más rara."
  },
  {
    "file": "v3_4_17.jpg",
    "startSec": 258.56,
    "text": "Número 10."
  },
  {
    "file": "v3_4_19.jpg",
    "startSec": 259.56,
    "text": "El freno selectivo."
  },
  {
    "file": "v3_4_20.jpg",
    "startSec": 260.94,
    "text": "El empollón del examen."
  },
  {
    "file": "v3_4_22.jpg",
    "startSec": 262.8,
    "text": "2022. En Corea descubren"
  },
  {
    "file": "v3_4_24.jpg",
    "startSec": 264.7,
    "text": "que un servicio de Samsung Frena sus Galaxy."
  },
  {
    "file": "v3_4_27.jpg",
    "startSec": 267.24,
    "text": "En una lista filtrada salían más de 10 .000 apps"
  },
  {
    "file": "v3_4_29.jpg",
    "startSec": 269.7,
    "text": "hasta Instagram y TikTok."
  },
  {
    "file": "v3_4_31.jpg",
    "startSec": 271.46,
    "text": "Pero faltaban las apps que miden la velocidad."
  },
  {
    "file": "v3_4_33.jpg",
    "startSec": 273.48,
    "text": "Geekbench lo llamó Manipulación."
  },
  {
    "file": "v3_4_36.jpg",
    "startSec": 276.08,
    "text": "Y borró de su ranking cuatro generaciones de Galaxy."
  },
  {
    "file": "v3_4_38.jpg",
    "startSec": 278.94,
    "text": "En 2026,"
  },
  {
    "file": "v3_4_40.jpg",
    "startSec": 280.04,
    "text": "un Tribunal de Seul obligó a Samsung"
  },
  {
    "file": "v3_4_41.jpg",
    "startSec": 281.62,
    "text": "a compensar a casi 2 .000 usuarios."
  },
  {
    "file": "v3_4_44.jpg",
    "startSec": 284.06,
    "text": "En el examen saca un 10."
  },
  {
    "file": "v3_4_45.jpg",
    "startSec": 285.76,
    "text": "En tu día a día, te frena."
  },
  {
    "file": "v3_4_47.jpg",
    "startSec": 287.68,
    "text": "Volvamos a la pregunta. ¿Te lo hacen a propósito?"
  },
  {
    "file": "v3_4_50.jpg",
    "startSec": 290.38,
    "text": "Lo he demostrado de esto."
  },
  {
    "file": "v3_4_52.jpg",
    "startSec": 292.04,
    "text": "Apple y Samsung frenaron móviles sin avisar."
  },
  {
    "file": "v3_4_54.jpg",
    "startSec": 294.58,
    "text": "Y pagaron por ello."
  },
  {
    "file": "v3_4_56.jpg",
    "startSec": 296.0,
    "text": "Pero hacerlo para que compres otro"
  },
  {
    "file": "v3_4_57.jpg",
    "startSec": 297.68,
    "text": "es lo más difícil de probar."
  },
  {
    "file": "v3_4_59.jpg",
    "startSec": 299.36,
    "text": "La ley francesa tardó"
  },
  {
    "file": "v3_5_00.jpg",
    "startSec": 300.7,
    "text": "más de 10 años en llegar"
  },
  {
    "file": "v3_5_02.jpg",
    "startSec": 302.04,
    "text": "a su primer juicio y fue"
  },
  {
    "file": "v3_5_03.jpg",
    "startSec": 303.5,
    "text": "contra una marca de impresoras."
  },
  {
    "file": "v3_5_05.jpg",
    "startSec": 305.34,
    "text": "Que te lo frenan, está demostrado."
  },
  {
    "file": "v3_5_07.jpg",
    "startSec": 307.38,
    "text": "Que sea para venderte otro, todavía no."
  },
  {
    "file": "v3_5_09.jpg",
    "startSec": 309.88,
    "text": "¿Y tú? ¿Cuántos años tiene tu móvil?"
  },
  {
    "file": "v3_5_12.jpg",
    "startSec": 312.02,
    "text": "Te leo en los comentarios."
  },
  {
    "file": "v3_5_13.jpg",
    "startSec": 313.4,
    "text": "Si te gusta entender cómo funciona de verdad"
  },
  {
    "file": "v3_5_15.jpg",
    "startSec": 315.22,
    "text": "la tecnología que usas cada día, suscríbete."
  },
  {
    "file": "v3_5_17.jpg",
    "startSec": 317.84,
    "text": "Cada semana, una máquina,"
  },
  {
    "file": "v3_5_19.jpg",
    "startSec": 319.28,
    "text": "un invento o una idea explicada fácil."
  }
]